# MacSW release identity (semantic versions; 0.2.0 is the first team release).
# APP_VERSION is CFBundleShortVersionString: numbers only. APP_BUILD is CFBundleVersion and only goes up.
# APP_RELEASE names the release in file names, git tags and BuildManifest.plist: APP_VERSION for a
# release, APP_VERSION-rc.N for a release candidate.
APP_VERSION="0.2.0"
APP_BUILD="7"
APP_RELEASE="0.2.0"
MACOS_DEPLOYMENT_TARGET="13.0"

# The packaged runtime and patched macOS driver must use the same Wine version.
WINE_VERSION="11.16"
WINE_RUNTIME_SHA256="6f9af818b7af6001aeed7818cb32bf0155598c5ea4e3b33380a03cf814e033cd"
WINE_SOURCE_SHA256="c66e2090343dcd727f7f7fd2f87ee0bfb0b118790c1d745ab7b8a4c3a4197f2f"
WINE_DRIVER_DEPLOYMENT_TARGET="10.15"

# Wine-Mono runtime replacements built from one validated 11.3.0 source revision.
WINE_MONO_VERSION="11.3.0"
MONO_PATCH_RELEASE="wine-mono-11.3.0-X86StdcallFix-ComRegistration-CCWFix"
MONO_PATCH_SOURCE_COMMIT="eb8d3270298d2d59f7e304d23e6af0ff374f4559"
MONO_PATCH_SHA256="d22ce0075cf56a0102455f435d4328da4e6c54a62504c51793f623faf58f989c"
MONO_X64_SHA256="ae74b6697eabedb66cb117f376da2d72af8247cd201e782583be8d9751d9e086"
MONO_MSCORLIB_SHA256="dd81a8c4d651c35f03387cf8ecef46cb5a171c072b19f23332c4adfb9980cea3"
MONO_REGASM_X86_SHA256="19c5d9d7c582e844793eb014e9f5d8ee7a4bc7a7e51666bcbe42a2a0b5485c42"
MONO_REGASM_X64_SHA256="b8a416296502c177717f49cfeb130ebaaed4b92e38ddaa0de2319766142b7553"

# Shared source archive is included for license compliance, not built locally.
MONO_SOURCE_COMMIT="edc3bfecdcb5c1c4705bdc9b82257d1d35143f06"
MONO_SOURCE_SHA256="751f127c1d7cc75c0a6db6c520b81c0366aeb74f23f1c6af1a4578abcf28ec51"

# stdole assembly required by SOLIDWORKS managed COM registration: the clean-room build in
# third_party/stdole-clean (LGPL-2.1-or-later, from Wine's stdole2.idl), not Microsoft's file.
STDOLE_VERSION="7.0.3300"
STDOLE_DLL_SHA256="e5d0ce39bfc7620ace151778527ebefeb92a255678c83ff6cc3cb8f550f1bac9"

# Standalone macOS extraction engine bundled with the app.
SEVEN_Z_VERSION="23.01"
SEVEN_Z_SHA256="343eae9ccbbd8f68320adaaa3c87e0244cf39fad0fbec6b9d2cd3e5b0f8a5fbf"
# Its source (LGPL parts). Checksum from the MacPorts 7zip 23.01 Portfile.
SEVEN_Z_SOURCE_URL="https://www.7-zip.org/a/7z2301-src.tar.xz"
SEVEN_Z_SOURCE_SHA256="356071007360e5a1824d9904993e8b2480b51b570e8c9faf7c0f58ebe4bf9f74"

# Source archives of the LGPL libraries in Resources/Wine/lib. They come unchanged from the Gcenx
# runtime above, which takes them from MacPorts and does not pin their versions. The versions
# were read from the libraries of that runtime (version strings and version numbers). The
# checksums are those of the MacPorts Portfiles of these versions; Homebrew has the same ones
# for libtasn1, libunistring, libidn2, libiconv and gettext. scripts/stage_source_release.sh
# copies them next to the DMG (make fetch-lgpl-sources downloads and checks them).
GNUTLS_VERSION="3.8.7"
GNUTLS_SOURCE_URL="https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-3.8.7.tar.xz"
