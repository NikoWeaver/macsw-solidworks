 }
 
+/* MacSW: replay a buffer of immediate-mode calls recorded by the PE side (see opengl32 private.h).
+ * Every unix call costs two gs base switches (_thread_set_tsd_base, about 0.16 us each under
+ * Rosetta), so one call per buffer instead of one per vertex. */
+NTSTATUS macsw_gl_batch( void *args )
+{
+    const struct macsw_gl_batch_params *params = args;
+    const struct opengl_funcs *funcs = params->teb->glTable;
+    const BYTE *ptr = params->data, *end = ptr + params->size;
+    UINT32 op = 0;
+
+#define BATCH_CALL( func, type, count ) \
+    do { type v[count]; if (end - ptr < sizeof(v)) goto truncated; memcpy( v, ptr, sizeof(v) ); ptr += sizeof(v); \
+         if (funcs->p_##func) funcs->p_##func( v ); } while (0)
+
+    while (end - ptr >= sizeof(op))
+    {
+        memcpy( &op, ptr, sizeof(op) );
+        ptr += sizeof(op);
+        switch (op)
+        {
+        case GL_BATCH_BEGIN:
+        {
+            GLenum mode;
+            if (end - ptr < sizeof(mode)) goto truncated;
+            memcpy( &mode, ptr, sizeof(mode) );
+            ptr += sizeof(mode);
+            if (funcs->p_glBegin) funcs->p_glBegin( mode );
+            break;
+        }
+        case GL_BATCH_END: if (funcs->p_glEnd) funcs->p_glEnd(); break;
+        case GL_BATCH_VERTEX2F: BATCH_CALL( glVertex2fv, GLfloat, 2 ); break;
+        case GL_BATCH_VERTEX3F: BATCH_CALL( glVertex3fv, GLfloat, 3 ); break;
+        case GL_BATCH_VERTEX3D: BATCH_CALL( glVertex3dv, GLdouble, 3 ); break;
+        case GL_BATCH_NORMAL3F: BATCH_CALL( glNormal3fv, GLfloat, 3 ); break;
+        case GL_BATCH_NORMAL3D: BATCH_CALL( glNormal3dv, GLdouble, 3 ); break;
+        case GL_BATCH_COLOR3F: BATCH_CALL( glColor3fv, GLfloat, 3 ); break;
+        case GL_BATCH_COLOR4F: BATCH_CALL( glColor4fv, GLfloat, 4 ); break;
+        case GL_BATCH_TEXCOORD2F: BATCH_CALL( glTexCoord2fv, GLfloat, 2 ); break;
+        case GL_BATCH_TEXCOORD2D: BATCH_CALL( glTexCoord2dv, GLdouble, 2 ); break;
+        default:
+            ERR( "invalid batch op %u\n", op );
+            return STATUS_INVALID_PARAMETER;
+        }
+    }
+#undef BATCH_CALL
+    if (ptr == end) return STATUS_SUCCESS;
+truncated:
+    ERR( "truncated batch op %u\n", op );
+    return STATUS_INVALID_PARAMETER;
+}
+
 #ifdef _WIN64
 
+NTSTATUS wow64_macsw_gl_batch( void *args )
+{
+    return STATUS_NOT_IMPLEMENTED;  /* the 32-bit PE side never batches */
+}
+
 static pthread_mutex_t wgl_lock = PTHREAD_MUTEX_INITIALIZER;
 
