From: MacSW maintainers
Subject: [PATCH] opengl32: Batch immediate-mode calls into one unix call (x86_64).

Every OpenGL call of the PE opengl32.dll is a unix call. On macOS the unix
call dispatcher switches the gs base twice per call (_thread_set_tsd_base),
which costs about 0.16 us each under Rosetta 2, so one glVertex3fv costs
about 0.44 us. SOLIDWORKS draws its model in immediate mode: about 585,000
glVertex3fv/glNormal3fv/glBegin/glEnd calls per redraw of a 9-part test
assembly, which took about 300 ms per redraw.

The PE side now records glBegin, glEnd, glVertex2f/3f/3d, glNormal3f/3d,
glColor3f/4f and glTexCoord2f/2d (and their v forms) in a 64 KB per-thread
buffer (TEB glReserved1[6]). None of them returns a value or reads state.
The new unix call macsw_gl_batch replays the buffer with the same driver
functions. Every other unix call of opengl32 (all generated thunks and
wgl.c, through UNIX_CALL) flushes the buffer first, and so does thread
detach, so the GL command order is unchanged and every query, glGetError,
glFlush/glFinish, SwapBuffers, wglMakeCurrent, display list compile and
selection/feedback result sees all earlier commands. Installing a GL debug
message callback turns batching off for the process, so that a synchronous
debug message is still reported from the call that caused it. The unix
side checks every record against the buffer size.

The unix call is appended to both call tables, so the existing indices
stay the same; the 32-bit PE side does not batch. MACSW_GL_BATCH=0 in the
environment turns batching off.

Measured with SOLIDWORKS 2026 (docs/graphics-performance.md).

diff --git a/dlls/opengl32/private.h b/dlls/opengl32/private.h
index ca7132d..8ed0425 100644
--- a/dlls/opengl32/private.h
+++ b/dlls/opengl32/private.h
@@ -20,6 +20,7 @@
 
 #include <stdarg.h>
 #include <stddef.h>
+#include <string.h>
 
 #include "ntstatus.h"
 #include "windef.h"
@@ -79,4 +80,52 @@ extern BOOL alloc_context_objects( enum object_type type, UINT n, const GLuint *
 extern GLuint *del_context_objects( enum object_type type, UINT n, GLuint *handles );
 extern GLuint *map_context_objects( enum object_type type, UINT n, GLuint *handles );
 
+/* MacSW: every unix call costs two gs base switches (about 0.33 us under Rosetta). Immediate-mode
+ * calls (glBegin, glVertex*, glNormal*, ...) are recorded in a per-thread buffer and replayed by
+ * one unix call. Any other unix call flushes the buffer first, so the order of GL commands is kept
+ * and every query, glGetError, glFlush/glFinish, SwapBuffers and context change sees all earlier
+ * commands. Installing a GL debug message callback turns batching off for the process, so that
+ * synchronous debug messages are still reported at the call that caused them.
+ * MACSW_GL_BATCH=0 in the environment turns this off. */
+#ifdef _WIN64
+#define WINE_GL_RESERVED_BATCH 6
+
+struct gl_batch
+{
+    UINT32 size;
+    BYTE data[65536 - sizeof(UINT32)];
+};
+
+extern LONG gl_batch_enabled;  /* -1: MACSW_GL_BATCH not read yet, 0: off, 1: on */
+extern struct gl_batch *gl_batch_init(void);
+extern void gl_batch_flush_now( struct gl_batch *batch );
+extern void gl_batch_disable(void);
+
+static inline void gl_batch_flush(void)
+{
+    struct gl_batch *batch = NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_BATCH];
+    if (batch && batch->size) gl_batch_flush_now( batch );
+}
+
+static inline BOOL gl_batch_put( UINT32 op, const void *data, UINT32 size )
+{
+    struct gl_batch *batch = NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_BATCH];
+    BYTE *ptr;
+
+    if (!gl_batch_enabled) return FALSE;
+    if (!batch && !(batch = gl_batch_init())) return FALSE;
+    if (batch->size + sizeof(op) + size > sizeof(batch->data)) gl_batch_flush_now( batch );
+    ptr = batch->data + batch->size;
+    memcpy( ptr, &op, sizeof(op) );
+    if (size) memcpy( ptr + sizeof(op), data, size );
+    batch->size += sizeof(op) + size;
+    return TRUE;
+}
+
+#undef UNIX_CALL
+#define UNIX_CALL( func, params ) (gl_batch_flush(), WINE_UNIX_CALL( unix_ ## func, params ))
+#else
+static inline BOOL gl_batch_put( UINT32 op, const void *data, UINT32 size ) { return FALSE; }
+#endif
+
 #endif /* __WINE_OPENGL32_PRIVATE_H */
