+/* MacSW: the hidden window of a native Show() is never ended with EndDialog,
+   which would re-enable the owner while the panel is up; the panel ends
+   instead (native_dialog_show) and Show() returns hr. */
+static void end_dialog(FileDialogImpl *This, HRESULT hr)
+{
+    if (This->native_shadow)
+    {
+        if (!This->native_close)
+        {
+            This->native_close = TRUE;
+            This->native_close_hr = hr;
+        }
+        return;
+    }
+    EndDialog(This->dlg_hwnd, hr);
+}
