+WINE_DEFAULT_DEBUG_CHANNEL(commdlg);
+
+/* enum macdrv_file_dialog_op in dlls/winemac.drv/unixlib.h */
+enum
+{
+    MACDLG_BEGIN,
+    MACDLG_POLL,
+    MACDLG_UPDATE,
+    MACDLG_CANCEL,
+    MACDLG_RELEASE,
+};
+
+typedef INT (WINAPI *macsw_file_dialog_func)(UINT op, UINT dialog, HWND owner, const char *in, UINT in_len,
+                                             char *out, UINT out_size, UINT *out_len);
+static macsw_file_dialog_func pmacsw_file_dialog;
+static char * (CDECL *pwine_get_unix_file_name)(const WCHAR *path);
+static WCHAR * (CDECL *pwine_get_dos_file_name)(const char *path);
+
+static WCHAR *get_env(const WCHAR *name)
+{
+    DWORD len = GetEnvironmentVariableW(name, NULL, 0);
+    WCHAR *value;
+
+    if (!len || !(value = malloc(len * sizeof(WCHAR)))) return NULL;
+    if (GetEnvironmentVariableW(name, value, len) >= len)
+    {
+        free(value);
+        return NULL;
+    }
+    return value;
+}
+
+/* MACSW_NATIVE_FILE_DIALOGS: 1 = native panels, 2 = "all" (also where the
+   program asks for the dialog window, see itemdlg.c), 0 = Wine dialogs. */
+static int gate_value(void)
+{
+    WCHAR *value = get_env(L"MACSW_NATIVE_FILE_DIALOGS");
+    int ret = 0;
+
+    if (value && !wcscmp(value, L"1")) ret = 1;
+    else if (value && !wcscmp(value, L"all")) ret = 2;
+    free(value);
+    return ret;
+}
+
+BOOL macdlg_everywhere(void)
+{
+    return gate_value() == 2;
+}
+
+/* The gate: MACSW_NATIVE_FILE_DIALOGS=1 (or all) and a winemac.drv with the export. */
+BOOL macdlg_enabled(void)
+{
+    HMODULE module;
+
+    if (!gate_value()) return FALSE;
+    if (pmacsw_file_dialog) return TRUE;
+
+    module = GetModuleHandleW(L"kernel32.dll");
+    pwine_get_unix_file_name = (void *)GetProcAddress(module, "wine_get_unix_file_name");
+    pwine_get_dos_file_name = (void *)GetProcAddress(module, "wine_get_dos_file_name");
+    if (!pwine_get_unix_file_name || !pwine_get_dos_file_name) return FALSE;
+
+    if (!(module = GetModuleHandleW(L"winemac.drv")))
+    {
+        TRACE("winemac.drv is not loaded, using the Wine dialog\n");
+        return FALSE;
+    }
+    pmacsw_file_dialog = (macsw_file_dialog_func)GetProcAddress(module, "macsw_file_dialog");
+    if (!pmacsw_file_dialog) WARN("winemac.drv has no macsw_file_dialog, using the Wine dialog\n");
+    return pmacsw_file_dialog != NULL;
+}
+
+/* Both return memory from the process heap (HeapFree). */
+char *macdlg_unix_path(const WCHAR *dos_path)
+{
+    return dos_path && dos_path[0] ? pwine_get_unix_file_name(dos_path) : NULL;
+}
+
+/* Windows cannot open names with these characters, a control character, or a
+   trailing dot or space; ':' is left alone (Wine opens such names). */
+static BOOL is_windows_name(const WCHAR *name)
+{
+    size_t len = wcslen(name), i;
+
+    if (!len || wcspbrk(name, L"\\/*?\"<>|") || name[len - 1] == '.' || name[len - 1] == ' ') return FALSE;
+    for (i = 0; i < len; i++) if (name[i] < 0x20) return FALSE;
+    return TRUE;
+}
+
+WCHAR *macdlg_dos_path(const char *unix_path)
+{
+    const char *slash;
+    WCHAR *path, *leaf, *dir, *ret;
+    WIN32_FIND_DATAW data;
+    HANDLE find;
+    size_t dir_len;
+    int len;
+
+    if (!unix_path || !unix_path[0] || !(path = pwine_get_dos_file_name(unix_path))) return NULL;
+
+    /* A macOS name that Windows cannot use ("q?x.txt", "name. "): return the
+       8.3 name that Wine lists for the file, which Windows programs can open. */
+    if (!(slash = strrchr(unix_path, '/')) || !slash[1]) return path;
+    len = MultiByteToWideChar(CP_UTF8, 0, slash + 1, -1, NULL, 0);
+    if (!(leaf = malloc(len * sizeof(WCHAR)))) return path;
+    MultiByteToWideChar(CP_UTF8, 0, slash + 1, -1, leaf, len);
+    if (!is_windows_name(leaf) && wcsrchr(path, '\\'))
+    {
+        dir_len = wcsrchr(path, '\\') - path + 1;
+        if ((dir = malloc((dir_len + 2) * sizeof(WCHAR))))
+        {
+            memcpy(dir, path, dir_len * sizeof(WCHAR));
+            lstrcpyW(dir + dir_len, L"*");
+            if ((find = FindFirstFileW(dir, &data)) != INVALID_HANDLE_VALUE)
+            {
+                do
+                {
+                    if (wcscmp(data.cFileName, leaf) || !data.cAlternateFileName[0]) continue;
+                    if ((ret = HeapAlloc(GetProcessHeap(), 0,
+                                         (dir_len + wcslen(data.cAlternateFileName) + 1) * sizeof(WCHAR))))
+                    {
+                        memcpy(ret, path, dir_len * sizeof(WCHAR));
+                        lstrcpyW(ret + dir_len, data.cAlternateFileName);
+                        TRACE("%s -> %s\n", debugstr_a(unix_path), debugstr_w(ret));
+                        HeapFree(GetProcessHeap(), 0, path);
+                        path = ret;
+                    }
+                    break;
+                } while (FindNextFileW(find, &data));
+                FindClose(find);
+            }
+            free(dir);
+        }
+    }
+    free(leaf);
+    return path;
+}
+
+
+/**************************************************************************
+ * A small JSON writer for the request to winemac.drv.
+ */
+void macdlg_json_init(struct macdlg_json *json)
+{
+    memset(json, 0, sizeof(*json));
+}
+
+void macdlg_json_free(struct macdlg_json *json)
+{
+    free(json->data);
+    macdlg_json_init(json);
+}
+
+static void json_append(struct macdlg_json *json, const char *str, size_t len)
+{
+    if (json->len + len + 1 > json->size)
+    {
+        size_t size = max(json->size * 2, json->len + len + 256);
+        char *data = realloc(json->data, size);
+        if (!data) return;
+        json->data = data;
+        json->size = size;
+    }
+    memcpy(json->data + json->len, str, len);
+    json->len += len;
+    json->data[json->len] = 0;
+}
+
+static void json_escaped(struct macdlg_json *json, const char *str)
+{
+    char buf[8];
+
+    json_append(json, "\"", 1);
+    for (; *str; str++)
+    {
+        unsigned char c = *str;
+        if (c == '"' || c == '\\')
+        {
+            buf[0] = '\\';
+            buf[1] = c;
+            json_append(json, buf, 2);
+        }
+        else if (c < 0x20)
+        {
+            sprintf(buf, "\\u%04x", c);
+            json_append(json, buf, 6);
+        }
+        else json_append(json, (const char *)str, 1);
+    }
+    json_append(json, "\"", 1);
+}
+
+static void json_key(struct macdlg_json *json, const char *key)
+{
+    if (json->comma) json_append(json, ",", 1);
+    json->comma = TRUE;
+    if (!key) return;
+    json_escaped(json, key);
+    json_append(json, ":", 1);
+}
+
+void macdlg_json_open(struct macdlg_json *json, const char *key, char bracket)
+{
+    json_key(json, key);
+    json_append(json, &bracket, 1);
+    json->comma = FALSE;
+}
+
+void macdlg_json_close(struct macdlg_json *json, char bracket)
+{
+    json_append(json, &bracket, 1);
+    json->comma = TRUE;
+}
+
+void macdlg_json_utf8(struct macdlg_json *json, const char *key, const char *value)
+{
+    if (!value) return;
+    json_key(json, key);
+    json_escaped(json, value);
+}
+
+void macdlg_json_string(struct macdlg_json *json, const char *key, const WCHAR *value)
+{
+    char *utf8;
+    int len;
+
+    if (!value) return;
+    len = WideCharToMultiByte(CP_UTF8, 0, value, -1, NULL, 0, NULL, NULL);
+    if (!(utf8 = malloc(len))) return;
+    WideCharToMultiByte(CP_UTF8, 0, value, -1, utf8, len, NULL, NULL);
+    macdlg_json_utf8(json, key, utf8);
+    free(utf8);
+}
+
+void macdlg_json_int(struct macdlg_json *json, const char *key, LONGLONG value)
+{
+    char buf[32];
+
+    json_key(json, key);
+    sprintf(buf, "%I64d", value);
+    json_append(json, buf, strlen(buf));
+}
+
+void macdlg_json_bool(struct macdlg_json *json, const char *key, BOOL value)
+{
+    json_key(json, key);
+    json_append(json, value ? "true" : "false", value ? 4 : 5);
+}
+
+void macdlg_json_folder(struct macdlg_json *json, const WCHAR *dos_path)
+{
+    char *unix_path = macdlg_unix_path(dos_path);
+
+    macdlg_json_utf8(json, "directory", unix_path);
+    HeapFree(GetProcessHeap(), 0, unix_path);
+}
+
+/* One {"name":..., "patterns":[...]} entry; "*.prt; *.sldprt" gives two patterns. */
+void macdlg_json_filter(struct macdlg_json *json, const WCHAR *name, const WCHAR *spec)
+{
+    const WCHAR *start, *end;
+    WCHAR *pattern;
+    size_t len;
+
+    macdlg_json_open(json, NULL, '{');
+    macdlg_json_string(json, "name", name ? name : L"");
+    macdlg_json_open(json, "patterns", '[');
+    for (start = spec; start && *start; start = *end ? end + 1 : end)
+    {
+        while (*start == ' ') start++;
+        if (!(end = wcschr(start, ';'))) end = start + wcslen(start);
+        if (!(len = end - start)) continue;
+        if (!(pattern = malloc((len + 1) * sizeof(WCHAR)))) break;
+        memcpy(pattern, start, len * sizeof(WCHAR));
+        pattern[len] = 0;
+        while (len && pattern[len - 1] == ' ') pattern[--len] = 0;
+        if (len) macdlg_json_string(json, NULL, pattern);
+        free(pattern);
+    }
+    macdlg_json_close(json, ']');
+    macdlg_json_close(json, '}');
+}
+
+void macdlg_json_test(struct macdlg_json *json)
+{
+    WCHAR *response = get_env(L"MACSW_NATIVE_FILE_DIALOG_TEST");
+    WCHAR *delay, *type, *controls;
+
+    if (!response) return;
+    delay = get_env(L"MACSW_NATIVE_FILE_DIALOG_TEST_DELAY_MS");
+    type = get_env(L"MACSW_NATIVE_FILE_DIALOG_TEST_TYPE");
+    controls = get_env(L"MACSW_NATIVE_FILE_DIALOG_TEST_CONTROLS");
+
+    macdlg_json_open(json, "test", '{');
+    macdlg_json_string(json, "response", response);
+    if (delay) macdlg_json_int(json, "delayMs", wcstol(delay, NULL, 10));
+    if (type) macdlg_json_int(json, "type", wcstol(type, NULL, 10));
+    macdlg_json_string(json, "controls", controls);
+    macdlg_json_close(json, '}');
+
+    free(response);
+    free(delay);
+    free(type);
+    free(controls);
+}
+
+
+/**************************************************************************
+ * Session: start the panel, pump messages while polling, end it.
+ */
+/* Like DialogBox: the top-level owner is disabled while the dialog is up. */
+void macdlg_disable_owner(struct macdlg_owner *state, HWND owner)
+{
+    memset(state, 0, sizeof(*state));
+    state->active = GetActiveWindow();
+    state->focus = GetFocus();
+    if (owner) owner = GetAncestor(owner, GA_ROOT);
+    state->owner = owner;
+    if (!owner || !IsWindowEnabled(owner)) return;
+    EnableWindow(owner, FALSE);
+    state->disabled = owner;
+}
+
+/* Activation goes back to the owner if comdlg32 disabled it (as when a modal
+   dialog ends), otherwise to the window that was active, e.g. an outer modal
+   dialog that had disabled the owner itself; the focus goes back too. */
+void macdlg_restore_owner(struct macdlg_owner *state, BOOL activate)
+{
+    HWND active = state->disabled ? state->disabled : state->active;
+
+    if (state->disabled && IsWindow(state->disabled)) EnableWindow(state->disabled, TRUE);
+    if (!activate || !active || !IsWindow(active) ||
+        GetWindowThreadProcessId(active, NULL) != GetCurrentThreadId()) return;
+    SetActiveWindow(active);
+    if (state->focus && IsWindow(state->focus) && GetAncestor(state->focus, GA_ROOT) == GetActiveWindow())
+        SetFocus(state->focus);
+}
+
+BOOL macdlg_begin(struct macdlg_session *session, HWND owner, const struct macdlg_json *request)
+{
+    memset(session, 0, sizeof(*session));
+    if (!request->data) return FALSE;
+
+    /* The panel becomes a sheet of the owner's Cocoa window when it has one. */
+    if (owner) owner = GetAncestor(owner, GA_ROOT);
+    session->owner = owner;
+
+    TRACE("request %s\n", debugstr_a(request->data));
+    session->begin_time = GetTickCount();
+    session->dialog = pmacsw_file_dialog(MACDLG_BEGIN, 0, owner, request->data, request->len, NULL, 0, NULL);
+    if (session->dialog <= 0)
+    {
+        WARN("winemac.drv could not start the panel, using the Wine dialog\n");
+        session->dialog = 0;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void unescape_field(char *field)
+{
+    char *src, *dst;
+
+    for (src = dst = field; *src; src++)
+    {
+        if (*src == '\\' && src[1])
+        {
+            src++;
+            switch (*src)
+            {
+            case 't': *dst++ = '\t'; break;
+            case 'n': *dst++ = '\n'; break;
+            case 'r': *dst++ = '\r'; break;
+            default:  *dst++ = *src; break;
+            }
+        }
+        else *dst++ = *src;
+    }
+    *dst = 0;
+}
+
+static void dispatch_lines(struct macdlg_session *session, char *data, macdlg_line_callback callback,
+                           void *context)
+{
+    char *line, *next, **argv = NULL;
+    int argc, capacity = 0;
+
+    for (line = data; line && *line; line = next)
+    {
+        char *field;
+
+        if ((next = strchr(line, '\n'))) *next++ = 0;
+        argc = 0;
+        for (field = line; field; )
+        {
+            char *tab = strchr(field, '\t');
+            if (tab) *tab++ = 0;
+            if (argc == capacity)
+            {
+                char **tmp = realloc(argv, (capacity = capacity * 2 + 8) * sizeof(*argv));
+                if (!tmp) goto done;
+                argv = tmp;
+            }
+            unescape_field(field);
+            argv[argc++] = field;
+            field = tab;
+        }
+        TRACE("line %s (%d fields)\n", debugstr_a(argv[0]), argc);
+        if (!strcmp(argv[0], "started")) session->started = TRUE;
+        else callback(context, argc, argv);
+    }
+done:
+    free(argv);
+}
+
+/* One round of the modal loop. Returns 0 while the panel is up, 1 once it has
+   ended, MACDLG_NOT_STARTED if it never came up (an exception in winemac.drv,
+   or no "started" line within 10 s), -1 on errors. */
+int macdlg_step(struct macdlg_session *session, macdlg_line_callback callback, void *context)
+{
+    UINT len = 0;
+    MSG msg;
+    int state;
+
+    MsgWaitForMultipleObjectsEx(0, NULL, 50, QS_ALLINPUT, MWMO_INPUTAVAILABLE);
+    while (!session->quit && PeekMessageW(&msg, 0, 0, 0, PM_REMOVE))
+    {
+        if (msg.message == WM_QUIT)
+        {
+            /* Like a modal loop: end the dialog and re-post WM_QUIT afterwards. */
+            session->quit = TRUE;
+            session->quit_code = msg.wParam;
+            macdlg_cancel(session);
+            break;
+        }
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+    }
+    if (session->owner && !IsWindow(session->owner))
+    {
+        session->owner = NULL;
+        macdlg_cancel(session);
+    }
+
+    for (;;)
+    {
+        if (!session->buffer)
+        {
+            session->buffer_size = 64 * 1024;
+            if (!(session->buffer = malloc(session->buffer_size + 1))) return -1;
+        }
+        state = pmacsw_file_dialog(MACDLG_POLL, session->dialog, NULL, NULL, 0,
+                                   session->buffer, session->buffer_size, &len);
+        if (state != 2) break;
+        free(session->buffer);
+        session->buffer = NULL;
+        session->buffer_size = 0;
+        if (!(session->buffer = malloc(len + 1))) return -1;
+        session->buffer_size = len;
+    }
+    if (state < 0) return -1;
+
+    session->buffer[min(len, session->buffer_size)] = 0;
+    if (len) dispatch_lines(session, session->buffer, callback, context);
+
+    if (!session->started && !session->cancelled &&
+        (state == 1 || GetTickCount() - session->begin_time > 10000))
+    {
+        WARN("the panel did not start\n");
+        if (state != 1) macdlg_cancel(session);
+        return MACDLG_NOT_STARTED;
+    }
+    return state == 1;
+}
+
+void macdlg_update(struct macdlg_session *session, const struct macdlg_json *update)
+{
+    if (!session->dialog || !update->data) return;
+    TRACE("update %s\n", debugstr_a(update->data));
+    pmacsw_file_dialog(MACDLG_UPDATE, session->dialog, NULL, update->data, update->len, NULL, 0, NULL);
+}
+
+void macdlg_cancel(struct macdlg_session *session)
+{
+    session->cancelled = TRUE;
+    if (session->dialog) pmacsw_file_dialog(MACDLG_CANCEL, session->dialog, NULL, NULL, 0, NULL, 0, NULL);
+}
+
+void macdlg_end(struct macdlg_session *session)
+{
+    if (session->dialog) pmacsw_file_dialog(MACDLG_RELEASE, session->dialog, NULL, NULL, 0, NULL, 0, NULL);
+    session->dialog = 0;
+    if (session->quit) PostQuitMessage(session->quit_code);
+    free(session->buffer);
+    session->buffer = NULL;
+}
