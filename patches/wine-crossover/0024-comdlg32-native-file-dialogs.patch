+extern void macdlg_json_string(struct macdlg_json *json, const char *key, const WCHAR *value);
+extern void macdlg_json_utf8(struct macdlg_json *json, const char *key, const char *value);
+extern void macdlg_json_int(struct macdlg_json *json, const char *key, LONGLONG value);
+extern void macdlg_json_bool(struct macdlg_json *json, const char *key, BOOL value);
+extern void macdlg_json_folder(struct macdlg_json *json, const WCHAR *dos_path);
+extern void macdlg_json_filter(struct macdlg_json *json, const WCHAR *name, const WCHAR *spec);
+extern void macdlg_json_test(struct macdlg_json *json);
+
+extern void macdlg_disable_owner(struct macdlg_owner *state, HWND owner);
+extern void macdlg_restore_owner(struct macdlg_owner *state, BOOL activate);
+extern BOOL macdlg_begin(struct macdlg_session *session, HWND owner, const struct macdlg_json *request);
+extern int macdlg_step(struct macdlg_session *session, macdlg_line_callback callback, void *context);
+extern void macdlg_update(struct macdlg_session *session, const struct macdlg_json *update);
+extern void macdlg_cancel(struct macdlg_session *session);
+extern void macdlg_end(struct macdlg_session *session);
+
+#endif /* _WINE_COMDLG32_MACDLG_H */
