  *      GetFileDialog95
  *
@@ -548,11 +895,13 @@ static BOOL GetFileDialog95(FileOpenDlgInfos *info, UINT dlg_type)
     switch (dlg_type)
     {
     case OPEN_DIALOG:
-        ret = GetFileName95(info);
+        if (!native_get_file_name(info, FALSE, &ret))
+            ret = GetFileName95(info);
         break;
     case SAVE_DIALOG:
         info->DlgInfos.dwDlgProp |= FODPROP_SAVEDLG;
-        ret = GetFileName95(info);
+        if (!native_get_file_name(info, TRUE, &ret))
+            ret = GetFileName95(info);
         break;
     default:
         ret = FALSE;
