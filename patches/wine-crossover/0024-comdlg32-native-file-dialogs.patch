+/***********************************************************************
+ *      MacSW native panel (macdlg.h)
+ *
+ * With MACSW_NATIVE_FILE_DIALOGS=1, GetOpenFileName and GetSaveFileName use
+ * NSOpenPanel/NSSavePanel. Hooks and custom templates need a real dialog
+ * window (CDN_* notifications, CDM_* messages, child dialogs), and an open
+ * dialog with OFN_CREATEPROMPT must accept names of files that do not exist
+ * yet, which NSOpenPanel cannot: those keep the Wine dialog, because
+ * correctness for the application comes first.
+ */
+#define NATIVE_READONLY_ID 0x7fff0001
+
+struct native_ofn
+{
+    BOOL done, ok, readonly;
+    UINT type;
+    UINT count;
+    WCHAR **paths;
+};
+
+static void native_ofn_line(void *context, int argc, char **argv)
+{
+    struct native_ofn *res = context;
+
+    if (!strcmp(argv[0], "type") && argc >= 2)
+        res->type = strtoul(argv[1], NULL, 10);
+    else if (!strcmp(argv[0], "check") && argc >= 3 && strtoul(argv[1], NULL, 10) == NATIVE_READONLY_ID)
+        res->readonly = atoi(argv[2]) != 0;
+    else if (!strcmp(argv[0], "path") && argc >= 2)
+    {
+        WCHAR *path = macdlg_dos_path(argv[1]), **paths;
+
+        if (path && (paths = realloc(res->paths, (res->count + 1) * sizeof(*paths))))
+        {
+            res->paths = paths;
+            if ((paths[res->count] = malloc((lstrlenW(path) + 1) * sizeof(WCHAR))))
+                lstrcpyW(paths[res->count++], path);
+        }
+        HeapFree(GetProcessHeap(), 0, path);
+    }
+    else if (!strcmp(argv[0], "result") && argc >= 2)
+    {
+        res->done = TRUE;
+        res->ok = !strcmp(argv[1], "ok");
+    }
+}
+
+/* Initial folder and name, in the order FILEDLG95_InitControls() uses. */
+static void native_ofn_start(FileOpenDlgInfos *info, WCHAR *dir, WCHAR *name)
+{
+    WCHAR buf[MAX_PATH], *part = NULL;
+
+    dir[0] = name[0] = 0;
+    if (info->filename && info->filename[0] && !wcspbrk(info->filename, L"*?"))
+    {
+        if (wcschr(info->filename, '\\') && GetFullPathNameW(info->filename, MAX_PATH, buf, &part))
+        {
+            if (part)
+            {
+                lstrcpynW(name, part, MAX_PATH);
+                *part = 0;
+            }
+            lstrcpynW(dir, buf, MAX_PATH);
+            return;
+        }
+        lstrcpynW(name, info->filename, MAX_PATH);
+    }
+    if (info->initdir && info->initdir[0] && GetFullPathNameW(info->initdir, MAX_PATH, buf, NULL) &&
+        PathFileExistsW(buf))
+    {
+        if (!PathIsDirectoryW(buf)) PathRemoveFileSpecW(buf);
+        lstrcpyW(dir, buf);
+        return;
+    }
+    buf[0] = 0;
+    FILEDLG95_MRU_load_filename(buf);
+    if (buf[0] && PathFileExistsW(buf))
+    {
+        if (!PathIsDirectoryW(buf)) PathRemoveFileSpecW(buf);
+        lstrcpyW(dir, buf);
+    }
+    /* Otherwise macOS opens the panel where the user last was. */
+}
+
+static const WCHAR *native_ofn_filter_spec(const WCHAR *filter, UINT index)
+{
+    while (filter && *filter)
+    {
+        const WCHAR *spec = filter + lstrlenW(filter) + 1;
+        if (!*spec) break;
+        if (!index--) return spec;
+        filter = spec + lstrlenW(spec) + 1;
+    }
+    return NULL;
+}
+
+static void native_ofn_request(FileOpenDlgInfos *info, BOOL save, struct macdlg_json *json)
+{
+    OPENFILENAMEW *ofn = info->ofnInfos;
+    WCHAR dir[MAX_PATH], name[MAX_PATH], title[64];
+    const WCHAR *filter;
+    UINT index = 0, count = 0;
+
+    native_ofn_start(info, dir, name);
+
+    macdlg_json_open(json, NULL, '{');
+    macdlg_json_utf8(json, "mode", save ? "save" : "open");
+    if (info->title)
+        macdlg_json_string(json, "title", info->title);
+    else if (save && LoadStringW(COMDLG32_hInstance, IDS_SAVE_AS, title, ARRAY_SIZE(title)))
+        macdlg_json_string(json, "title", title);
+    if (dir[0]) macdlg_json_folder(json, dir);
+    if (name[0]) macdlg_json_string(json, "fileName", name);
+    macdlg_json_open(json, "filters", '[');
+    for (filter = info->filter; filter && *filter; count++)
+    {
+        const WCHAR *spec = filter + lstrlenW(filter) + 1;
+        if (!*spec) break;
+        macdlg_json_filter(json, filter, spec);
+        filter = spec + lstrlenW(spec) + 1;
+    }
+    macdlg_json_close(json, ']');
+    if (ofn->nFilterIndex && ofn->nFilterIndex <= count) index = ofn->nFilterIndex - 1;
+    macdlg_json_int(json, "filterIndex", index);
+    macdlg_json_string(json, "defaultExt", info->defext);
+    /* Windows appends an extension only when lpstrDefExt is set. */
+    macdlg_json_bool(json, "appendExtension", info->defext != NULL);
+    macdlg_json_bool(json, "multiple", (ofn->Flags & OFN_ALLOWMULTISELECT) != 0);
+    macdlg_json_bool(json, "showHidden", (ofn->Flags & OFN_FORCESHOWHIDDEN) != 0);
+    macdlg_json_open(json, "controls", '[');
+    if (!save && !filedialog_is_readonly_hidden(info))
+    {
+        macdlg_json_open(json, NULL, '{');
+        macdlg_json_int(json, "id", NATIVE_READONLY_ID);
+        macdlg_json_utf8(json, "type", "check");
+        macdlg_json_utf8(json, "label", "Open as read-only");
+        macdlg_json_bool(json, "checked", (ofn->Flags & OFN_READONLY) != 0);
+        macdlg_json_close(json, '}');
+    }
+    macdlg_json_close(json, ']');
+    macdlg_json_test(json);
+    macdlg_json_close(json, '}');
+}
+
+/* Store a W result list (with its terminating NULs) in lpstrFile, W or A. */
+static BOOL native_ofn_store(FileOpenDlgInfos *info, const WCHAR *list, UINT len, UINT *offset_out)
+{
+    OPENFILENAMEW *ofn = info->ofnInfos;
+    UINT size = len;
+
+    if (!info->unicode)
+        size = WideCharToMultiByte(CP_ACP, 0, list, len, NULL, 0, NULL, NULL);
+    if (size > ofn->nMaxFile)
+    {
+        if (ofn->lpstrFile && ofn->nMaxFile >= 2) *(WORD *)ofn->lpstrFile = size;
+        COMDLG32_SetCommDlgExtendedError(FNERR_BUFFERTOOSMALL);
+        return FALSE;
+    }
+    if (!ofn->lpstrFile) return TRUE;
+    if (info->unicode)
+        memcpy(ofn->lpstrFile, list, len * sizeof(WCHAR));
+    else
+        WideCharToMultiByte(CP_ACP, 0, list, len, (char *)ofn->lpstrFile, ofn->nMaxFile, NULL, NULL);
+    if (offset_out && !info->unicode)
+        *offset_out = WideCharToMultiByte(CP_ACP, 0, list, *offset_out, NULL, 0, NULL, NULL);
+    return TRUE;
+}
+
+static BOOL native_ofn_result(FileOpenDlgInfos *info, BOOL save, struct native_ofn *res)
+{
+    OPENFILENAMEW *ofn = info->ofnInfos;
+    BOOL multi = (ofn->Flags & OFN_ALLOWMULTISELECT) != 0;
+    WCHAR *path = res->paths[0], *list, *ext, *p, dir[MAX_PATH];
+    UINT len, i, offset, ext_offset, dir_len = 0, prefix_len = 0, n;
+
+    if (info->filter && *info->filter) ofn->nFilterIndex = res->type + 1;
+    if (res->readonly) ofn->Flags |= OFN_READONLY;
+    else ofn->Flags &= ~OFN_READONLY;
+
+    if (res->count > 1 && multi)
+    {
+        /* One folder per list: items the panel found elsewhere (search results,
+           Recents) are left out, as the Windows dialog cannot pick them together. */
+        lstrcpynW(dir, path, MAX_PATH);
+        PathRemoveFileSpecW(dir);
+        dir_len = lstrlenW(dir);
+        prefix_len = dir_len && dir[dir_len - 1] == '\\' ? dir_len : dir_len + 1;   /* "C:\" or "C:\dir" */
+        for (i = n = 0; i < res->count; i++)
+        {
+            const WCHAR *item = res->paths[i];
+            if (!i || (!wcsnicmp(item, dir, dir_len) && (prefix_len == dir_len || item[dir_len] == '\\') &&
+                       item[prefix_len] && !wcschr(item + prefix_len, '\\')))
+                res->paths[n++] = res->paths[i];
+            else
+                free(res->paths[i]);
+        }
+        res->count = n;
+    }
+
+    if (res->count > 1 && multi)
+    {
+        /* "dir\0name1\0name2\0\0" like FILEDLG95_OnOpenMultipleFiles() */
+        len = dir_len + 2;
+        for (i = 0; i < res->count; i++) len += lstrlenW(res->paths[i] + prefix_len) + 1;
+        if (!(list = malloc(len * sizeof(WCHAR)))) return FALSE;
+        lstrcpyW(list, dir);
+        p = list + dir_len + 1;
+        for (i = 0; i < res->count; i++)
+        {
+            lstrcpyW(p, res->paths[i] + prefix_len);
+            p += lstrlenW(p) + 1;
+        }
+        *p++ = 0;
+        offset = dir_len + 1;
+        if (!native_ofn_store(info, list, p - list, &offset))
+        {
+            free(list);
+            return FALSE;
+        }
+        ofn->nFileOffset = offset;
+        ofn->nFileExtension = 0;
+        free(list);
+    }
+    else
+    {
+        /* Extension and flags as in FILEDLG95_OnOpen(ONOPEN_OPEN). */
+        len = lstrlenW(path);
+        if (!(list = malloc((len + MAX_PATH + 3) * sizeof(WCHAR)))) return FALSE;
+        lstrcpyW(list, path);
+        ext = PathFindExtensionW(list);
+        if (!*ext && info->defext)
+        {
+            const WCHAR *spec = native_ofn_filter_spec(info->filter, res->type);
+            WCHAR buf[MAX_PATH], *dot = NULL, *end;
+
+            buf[0] = 0;
+            if (spec)
+            {
+                lstrcpynW(buf, spec, MAX_PATH);
+                if ((end = wcschr(buf, ';'))) *end = 0;
+                if (!(dot = wcschr(buf, '.')) || wcspbrk(dot + 1, L"*?")) buf[0] = 0;
+                else memmove(buf, dot + 1, (lstrlenW(dot + 1) + 1) * sizeof(WCHAR));
+            }
+            if (!buf[0]) lstrcpynW(buf, info->defext, MAX_PATH);
+            if (buf[0])
+            {
+                lstrcatW(list, L".");
+                lstrcatW(list, buf);
+            }
+            /* In an open dialog an existing file without the extension wins. */
+            if (!save && !PathFileExistsW(list)) list[len] = 0;
+        }
+        ext = PathFindExtensionW(list);
+        if (info->defext)
+        {
+            if (!lstrcmpiW(info->defext, *ext ? ext + 1 : ext)) ofn->Flags &= ~OFN_EXTENSIONDIFFERENT;
+            else ofn->Flags |= OFN_EXTENSIONDIFFERENT;
+        }
+        len = lstrlenW(list);
+        offset = PathFindFileNameW(list) - list;
+        ext_offset = *ext ? ext - list + 1 : 0;
+        list[len + 1] = 0;
+        if (!native_ofn_store(info, list, len + 1 + (multi ? 1 : 0), &offset))
+        {
+            free(list);
+            return FALSE;
+        }
+        if (!info->unicode && ext_offset)
+            ext_offset = WideCharToMultiByte(CP_ACP, 0, list, ext_offset, NULL, 0, NULL, NULL);
+        ofn->nFileOffset = offset;
+        ofn->nFileExtension = ext_offset;
+
+        if (ofn->lpstrFileTitle)
+        {
+            if (info->unicode)
+                lstrcpynW(ofn->lpstrFileTitle, PathFindFileNameW(list), ofn->nMaxFileTitle);
+            else
+                WideCharToMultiByte(CP_ACP, 0, PathFindFileNameW(list), -1,
+                                    (char *)ofn->lpstrFileTitle, ofn->nMaxFileTitle, NULL, NULL);
+        }
+        path = list;
+        FILEDLG95_MRU_save_filename(list);
+        if (!(ofn->Flags & OFN_NOCHANGEDIR))
+        {
+            PathRemoveFileSpecW(list);
+            SetCurrentDirectoryW(list);
+        }
+        free(list);
+        return TRUE;
+    }
+
+    if (!(ofn->Flags & OFN_NOCHANGEDIR))
+    {
+        WCHAR dir[MAX_PATH];
+        lstrcpynW(dir, res->paths[0], MAX_PATH);
+        PathRemoveFileSpecW(dir);
+        SetCurrentDirectoryW(dir);
+    }
+    return TRUE;
+}
+
+static BOOL native_get_file_name(FileOpenDlgInfos *info, BOOL save, BOOL *ret)
+{
+    OPENFILENAMEW *ofn = info->ofnInfos;
+    struct macdlg_session session;
+    struct macdlg_json json;
+    struct native_ofn res;
+    struct macdlg_owner owner_state;
+    UINT i;
+    int state;
+
+    if (is_dialog_hooked(info) || (ofn->Flags & (OFN_ENABLETEMPLATE | OFN_ENABLETEMPLATEHANDLE)))
+        return FALSE;
+    if (!save && (ofn->Flags & OFN_CREATEPROMPT)) return FALSE;
+    if (!macdlg_enabled()) return FALSE;
+
+    macdlg_json_init(&json);
+    native_ofn_request(info, save, &json);
+    macdlg_disable_owner(&owner_state, ofn->hwndOwner);
+    if (!macdlg_begin(&session, ofn->hwndOwner, &json))
+    {
+        macdlg_restore_owner(&owner_state, FALSE);
+        macdlg_json_free(&json);
+        return FALSE;
+    }
+    macdlg_json_free(&json);
+
+    memset(&res, 0, sizeof(res));
+    while (!(state = macdlg_step(&session, native_ofn_line, &res)) && !res.done)
+        ;
+    macdlg_end(&session);
+
+    if (state != MACDLG_NOT_STARTED)
+    {
+        COMDLG32_SetCommDlgExtendedError(0);
+        *ret = state >= 0 && res.ok && res.count && native_ofn_result(info, save, &res);
+        TRACE("native panel returns %d\n", *ret);
+    }
+    /* The panel did not come up: the Wine dialog instead. */
+    macdlg_restore_owner(&owner_state, state != MACDLG_NOT_STARTED);
+
+    for (i = 0; i < res.count; i++) free(res.paths[i]);
+    free(res.paths);
+    return state != MACDLG_NOT_STARTED;
+}
+
