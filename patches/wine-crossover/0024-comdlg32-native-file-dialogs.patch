+/**************************************************************************
+ * MacSW native panel (macdlg.h): with MACSW_NATIVE_FILE_DIALOGS=1, Show()
+ * runs NSOpenPanel/NSSavePanel instead of the Wine dialog. The dialog state
+ * stays where the Wine dialog keeps it (folder, selection, file type, the
+ * hidden custom control windows, results), so every getter and event works
+ * as before. The Wine dialog's window exists too, hidden (native_shadow_create),
+ * from before the first event to the end of Show(): IOleWindow::GetWindow
+ * returns it, and programs that subclass it or put their own windows into it
+ * (SOLIDWORKS's open options pane) work as with the Wine dialog, unseen. A
+ * program that asks for the window while the dialog opens gets the visible
+ * Wine dialog instead, unless MACSW_NATIVE_FILE_DIALOGS=all.
+ */
+static const char * const native_control_types[] =
+{
+    "menu", "button", "combo", "radio", "check", "edit", "separator", "text", NULL, "group"
+};
+
+struct native_context
+{
+    FileDialogImpl *This;
+    struct macdlg_session *session;
+    BOOL done, ok;
+    UINT panel_type;
+    UINT count;
+    WCHAR **paths;
+};
+
+static WCHAR *native_window_text(HWND hwnd)
+{
+    int len = GetWindowTextLengthW(hwnd);
+    WCHAR *text = malloc((len + 1) * sizeof(WCHAR));
+
+    if (text && !GetWindowTextW(hwnd, text, len + 1)) text[0] = 0;
+    return text;
+}
+
+static WCHAR *native_wcsdup_utf8(const char *str)
+{
+    int len = MultiByteToWideChar(CP_UTF8, 0, str, -1, NULL, 0);
+    WCHAR *ret = malloc(len * sizeof(WCHAR));
+
+    if (ret) MultiByteToWideChar(CP_UTF8, 0, str, -1, ret, len);
+    return ret;
+}
+
+static void native_write_control(FileDialogImpl *This, struct macdlg_json *json, customctrl *ctrl)
+{
+    IFileDialogCustomize *customize = &This->IFileDialogCustomize_iface;
+    WCHAR *text = NULL;
+    cctrl_item *item;
+    customctrl *sub;
+    DWORD selected;
+    BOOL checked = FALSE;
+
+    if (ctrl->type >= ARRAY_SIZE(native_control_types) || !native_control_types[ctrl->type]) return;
+
+    macdlg_json_open(json, NULL, '{');
+    macdlg_json_int(json, "id", ctrl->id);
+    macdlg_json_utf8(json, "type", native_control_types[ctrl->type]);
+    macdlg_json_bool(json, "visible", (ctrl->cdcstate & CDCS_VISIBLE) != 0);
+    macdlg_json_bool(json, "enabled", (ctrl->cdcstate & CDCS_ENABLED) != 0);
+
+    switch (ctrl->type)
+    {
+    case IDLG_CCTRL_MENU:
+    {
+        int len = SendMessageW(ctrl->hwnd, TB_GETBUTTONTEXTW, 1, 0);
+        if (len > 0 && (text = malloc((len + 1) * sizeof(WCHAR))))
+            SendMessageW(ctrl->hwnd, TB_GETBUTTONTEXTW, 1, (LPARAM)text);
+        macdlg_json_string(json, "label", text);
+        break;
+    }
+    case IDLG_CCTRL_PUSHBUTTON:
+    case IDLG_CCTRL_CHECKBUTTON:
+    case IDLG_CCTRL_TEXT:
+    case IDLG_CCTRL_VISUALGROUP:
+        macdlg_json_string(json, "label", text = native_window_text(ctrl->hwnd));
+        break;
+    case IDLG_CCTRL_EDITBOX:
+        macdlg_json_string(json, "text", text = native_window_text(ctrl->hwnd));
+        break;
+    default:
+        break;
+    }
+    free(text);
+
+    if (ctrl->type == IDLG_CCTRL_CHECKBUTTON)
+    {
+        IFileDialogCustomize_GetCheckButtonState(customize, ctrl->id, &checked);
+        macdlg_json_bool(json, "checked", checked);
+    }
+
+    if (ctrl->type == IDLG_CCTRL_COMBOBOX || ctrl->type == IDLG_CCTRL_RADIOBUTTONLIST ||
+        ctrl->type == IDLG_CCTRL_MENU)
+    {
+        macdlg_json_open(json, "items", '[');
+        LIST_FOR_EACH_ENTRY(item, &ctrl->sub_items, cctrl_item, entry)
+        {
+            macdlg_json_open(json, NULL, '{');
+            macdlg_json_int(json, "id", item->id);
+            macdlg_json_string(json, "label", item->label);
+            macdlg_json_bool(json, "visible", (item->cdcstate & CDCS_VISIBLE) != 0);
+            macdlg_json_bool(json, "enabled", (item->cdcstate & CDCS_ENABLED) != 0);
+            macdlg_json_close(json, '}');
+        }
+        macdlg_json_close(json, ']');
+        if (ctrl->type != IDLG_CCTRL_MENU &&
+            SUCCEEDED(IFileDialogCustomize_GetSelectedControlItem(customize, ctrl->id, &selected)))
+            macdlg_json_int(json, "selected", selected);
+    }
+
+    if (ctrl->type == IDLG_CCTRL_VISUALGROUP)
+    {
+        macdlg_json_open(json, "children", '[');
+        LIST_FOR_EACH_ENTRY(sub, &ctrl->sub_cctrls, customctrl, sub_cctrls_entry)
+            native_write_control(This, json, sub);
+        macdlg_json_close(json, ']');
+    }
+
+    macdlg_json_close(json, '}');
+}
+
+static void native_write_controls(FileDialogImpl *This, struct macdlg_json *json)
+{
+    customctrl *ctrl;
+
+    macdlg_json_open(json, "controls", '[');
+    LIST_FOR_EACH_ENTRY(ctrl, &This->cctrls, customctrl, entry)
+        native_write_control(This, json, ctrl);
+    macdlg_json_close(json, ']');
+}
+
+static void native_write_request(FileDialogImpl *This, struct macdlg_json *json)
+{
+    const WCHAR *ok_label = This->custom_okbutton;
+    WCHAR *folder;
+    cctrl_item *item;
+    UINT i;
+
+    if (This->hmenu_opendropdown && (item = get_first_item(&This->cctrl_opendropdown)))
+        ok_label = item->label;
+
+    macdlg_json_open(json, NULL, '{');
+    if (This->options & FOS_PICKFOLDERS)
+        macdlg_json_utf8(json, "mode", "folder");
+    else
+        macdlg_json_utf8(json, "mode", This->dlg_type == ITEMDLG_TYPE_SAVE ? "save" : "open");
+    macdlg_json_string(json, "title", This->custom_title);
+    macdlg_json_string(json, "okLabel", ok_label);
+    macdlg_json_string(json, "nameLabel", This->custom_filenamelabel);
+    if (This->psi_folder && SUCCEEDED(IShellItem_GetDisplayName(This->psi_folder, SIGDN_FILESYSPATH, &folder)))
+    {
+        macdlg_json_folder(json, folder);
+        CoTaskMemFree(folder);
+    }
+    if (This->set_filename && !wcspbrk(This->set_filename, L"*?"))
+        macdlg_json_string(json, "fileName", This->set_filename);
+    macdlg_json_open(json, "filters", '[');
+    for (i = 0; i < This->filterspec_count; i++)
+        macdlg_json_filter(json, This->filterspecs[i].pszName, This->filterspecs[i].pszSpec);
+    macdlg_json_close(json, ']');
+    macdlg_json_int(json, "filterIndex", This->filetypeindex);
+    macdlg_json_string(json, "defaultExt", This->default_ext);
+    macdlg_json_bool(json, "appendExtension", TRUE);
+    macdlg_json_bool(json, "multiple", (This->options & FOS_ALLOWMULTISELECT) != 0);
+    macdlg_json_bool(json, "showHidden", (This->options & FOS_FORCESHOWHIDDEN) != 0);
+    native_write_controls(This, json);
+    macdlg_json_test(json);
+    macdlg_json_close(json, '}');
+}
+
+static void native_set_folder(FileDialogImpl *This, IShellItem *folder)
+{
+    if (This->psi_folder) IShellItem_Release(This->psi_folder);
+    This->psi_folder = folder;
+}
+
+static IShellItem *native_item_from_unix(const char *unix_path)
+{
+    WCHAR *path = macdlg_dos_path(unix_path);
+    IShellItem *item = NULL;
+
+    if (path) SHCreateItemFromParsingName(path, NULL, &IID_IShellItem, (void **)&item);
+    HeapFree(GetProcessHeap(), 0, path);
+    return item;
+}
+
+static void native_set_selection(FileDialogImpl *This, int count, char **unix_paths)
+{
+    IShellFolder *desktop;
+    LPITEMIDLIST *pidls;
+    int i, n = 0;
+
+    if (This->psia_selection)
+    {
+        IShellItemArray_Release(This->psia_selection);
+        This->psia_selection = NULL;
+    }
+    if (count > 0 && (pidls = calloc(count, sizeof(*pidls))))
+    {
+        for (i = 0; i < count; i++)
+        {
+            WCHAR *path = macdlg_dos_path(unix_paths[i]);
+            if (path && (pidls[n] = SHSimpleIDListFromPath(path))) n++;
+            HeapFree(GetProcessHeap(), 0, path);
+        }
+        if (n && SUCCEEDED(SHGetDesktopFolder(&desktop)))
+        {
+            SHCreateShellItemArray(NULL, desktop, n, (PCUITEMID_CHILD_ARRAY)pidls, &This->psia_selection);
+            IShellFolder_Release(desktop);
+        }
+        for (i = 0; i < n; i++) ILFree(pidls[i]);
+        free(pidls);
+    }
+    fill_filename_from_selection(This);
+    events_OnSelectionChange(This);
+}
+
+static void json_busy(struct macdlg_json *json, BOOL busy)
+{
+    macdlg_json_open(json, NULL, '{');
+    macdlg_json_bool(json, "busy", busy);
+    macdlg_json_close(json, '}');
+}
+
+static void native_on_line(void *context, int argc, char **argv)
+{
+    struct native_context *ctx = context;
+    FileDialogImpl *This = ctx->This;
+    IFileDialogCustomize *customize = &This->IFileDialogCustomize_iface;
+    DWORD id = argc >= 2 ? strtoul(argv[1], NULL, 10) : 0;
+
+    if (!strcmp(argv[0], "folder") && argc >= 2)
+    {
+        IShellItem *folder = native_item_from_unix(argv[1]);
+
+        if (!folder) return;
+        events_OnFolderChanging(This, folder);
+        native_set_folder(This, folder);
+        events_OnFolderChange(This);
+    }
+    else if (!strcmp(argv[0], "selection"))
+    {
+        native_set_selection(This, argc - 1, argv + 1);
+    }
+    else if (!strcmp(argv[0], "type") && argc >= 2)
+    {
+        if (id < This->filterspec_count) ctx->panel_type = id;
+        if (id < This->filterspec_count && id != This->filetypeindex)
+        {
+            This->filetypeindex = id;
+            set_current_filter(This, This->filterspecs[id].pszSpec);
+            /* As a choice in the Wine dialog's type box. */
+            SendDlgItemMessageW(This->dlg_hwnd, IDC_FILETYPE, CB_SETCURSEL, id, 0);
+            events_OnTypeChange(This);
+        }
+    }
+    else if (!strcmp(argv[0], "check") && argc >= 3)
+    {
+        BOOL checked = atoi(argv[2]) != 0;
+
+        IFileDialogCustomize_SetCheckButtonState(customize, id, checked);
+        cctrl_event_OnCheckButtonToggled(This, id, checked);
+    }
+    else if (!strcmp(argv[0], "item") && argc >= 3)
+    {
+        customctrl *ctrl = get_cctrl(This, id);
+        DWORD item = strtoul(argv[2], NULL, 10);
+
+        if (!ctrl) return;
+        if (ctrl->type != IDLG_CCTRL_MENU)
+            IFileDialogCustomize_SetSelectedControlItem(customize, id, item);
+        cctrl_event_OnItemSelected(This, id, item);
+    }
+    else if (!strcmp(argv[0], "button") && argc >= 2)
+    {
+        /* The handler may run a modal dialog ("Options..."); the panel ignores
+           the mouse meanwhile, as Windows disables the file dialog. */
+        struct macdlg_json busy;
+
+        macdlg_json_init(&busy);
+        json_busy(&busy, TRUE);
+        macdlg_update(ctx->session, &busy);
+        cctrl_event_OnButtonClicked(This, id);
+        macdlg_json_free(&busy);
+        json_busy(&busy, FALSE);
+        macdlg_update(ctx->session, &busy);
+        macdlg_json_free(&busy);
+    }
+    else if (!strcmp(argv[0], "edit") && argc >= 3)
+    {
+        WCHAR *text = native_wcsdup_utf8(argv[2]);
+
+        if (text) IFileDialogCustomize_SetEditBoxText(customize, id, text);
+        free(text);
+    }
+    else if (!strcmp(argv[0], "path") && argc >= 2)
+    {
+        WCHAR *path = macdlg_dos_path(argv[1]), **paths;
+
+        if (path && (paths = realloc(ctx->paths, (ctx->count + 1) * sizeof(*paths))))
+        {
+            ctx->paths = paths;
+            if ((paths[ctx->count] = malloc((lstrlenW(path) + 1) * sizeof(WCHAR))))
+                lstrcpyW(paths[ctx->count++], path);
+        }
+        HeapFree(GetProcessHeap(), 0, path);
+    }
+    else if (!strcmp(argv[0], "result") && argc >= 2)
+    {
+        ctx->done = TRUE;
+        ctx->ok = !strcmp(argv[1], "ok");
+    }
+}
+
+static void native_controls_json(FileDialogImpl *This, struct macdlg_json *json)
+{
+    macdlg_json_init(json);
+    macdlg_json_open(json, NULL, '{');
+    native_write_controls(This, json);
+    macdlg_json_close(json, '}');
+}
+
+/* Send what the application changed, in its event handlers or at any other
+   time while the panel is up: controls, file name, file type and folder. */
+static void native_push_update(FileDialogImpl *This, struct native_context *ctx, struct macdlg_json *last)
+{
+    struct macdlg_json json;
+    WCHAR *folder;
+    BOOL changed = FALSE;
+
+    native_controls_json(This, &json);
+    if (!last->data || !json.data || strcmp(last->data, json.data))
+    {
+        macdlg_update(ctx->session, &json);
+        macdlg_json_free(last);
+        *last = json;
+    }
+    else macdlg_json_free(&json);
+
+    macdlg_json_init(&json);
+    macdlg_json_open(&json, NULL, '{');
+    if (This->native_filename_changed && This->set_filename)
+    {
+        macdlg_json_string(&json, "fileName", This->set_filename);
+        changed = TRUE;
+    }
+    if (This->filetypeindex != ctx->panel_type && This->filetypeindex < This->filterspec_count)
+    {
+        macdlg_json_int(&json, "filterIndex", This->filetypeindex);
+        ctx->panel_type = This->filetypeindex;
+        changed = TRUE;
+    }
+    if (This->native_folder_changed && This->psi_setfolder &&
+        SUCCEEDED(IShellItem_GetDisplayName(This->psi_setfolder, SIGDN_FILESYSPATH, &folder)))
+    {
+        macdlg_json_folder(&json, folder);
+        CoTaskMemFree(folder);
+        changed = TRUE;
+    }
+    macdlg_json_close(&json, '}');
+    if (changed) macdlg_update(ctx->session, &json);
+    macdlg_json_free(&json);
+    This->native_filename_changed = FALSE;
+    This->native_folder_changed = FALSE;
+}
+
+/* The user picked something: results, folder and name like on_default_action(). */
+static HRESULT native_accept(FileDialogImpl *This, struct native_context *ctx)
+{
+    IShellFolder *desktop;
+    LPITEMIDLIST *pidls;
+    WCHAR *path, *dir, extbuf[MAX_PATH], *newext = NULL;
+    IShellItem *item;
+    HRESULT hr;
+    UINT i;
+
+    /* NSSavePanel appended the type's extension and confirmed any overwrite.
+       Windows also adds the extension when the name has none; a name that
+       needs it here was not checked by the panel. */
+    This->native_prompted = TRUE;
+    if (This->dlg_type == ITEMDLG_TYPE_SAVE && !(This->options & FOS_PICKFOLDERS) &&
+        !*PathFindExtensionW(ctx->paths[0]))
+    {
+        if (This->current_filter)
+            newext = get_first_ext_from_spec(extbuf, This->current_filter);
+        if (!newext && This->default_ext)
+        {
+            lstrcpyW(extbuf, L".");
+            lstrcpynW(extbuf + 1, This->default_ext, ARRAY_SIZE(extbuf) - 1);
+            newext = extbuf;
+        }
+        if (newext && (path = malloc((lstrlenW(ctx->paths[0]) + lstrlenW(newext) + 1) * sizeof(WCHAR))))
+        {
+            lstrcpyW(path, ctx->paths[0]);
+            lstrcatW(path, newext);
+            free(ctx->paths[0]);
+            ctx->paths[0] = path;
+            This->native_prompted = FALSE;
+        }
+    }
+
+    hr = SHGetDesktopFolder(&desktop);
+    if (FAILED(hr)) return hr;
+    if (!(pidls = calloc(ctx->count, sizeof(*pidls))))
+    {
+        IShellFolder_Release(desktop);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < ctx->count; i++)
+        pidls[i] = SHSimpleIDListFromPath(ctx->paths[i]);
+    if (This->psia_results)
+    {
+        IShellItemArray_Release(This->psia_results);
+        This->psia_results = NULL;
+    }
+    hr = SHCreateShellItemArray(NULL, desktop, ctx->count, (PCUITEMID_CHILD_ARRAY)pidls, &This->psia_results);
+    IShellFolder_Release(desktop);
+    for (i = 0; i < ctx->count; i++) ILFree(pidls[i]);
+    free(pidls);
+    if (FAILED(hr)) return hr;
+
+    /* GetFolder() and GetFileName() as the Wine dialog leaves them; also where a re-shown panel starts. */
+    if ((dir = malloc((lstrlenW(ctx->paths[0]) + 1) * sizeof(WCHAR))))
+    {
+        lstrcpyW(dir, ctx->paths[0]);
+        PathRemoveFileSpecW(dir);
+        if (SUCCEEDED(SHCreateItemFromParsingName(dir, NULL, &IID_IShellItem, (void **)&item)))
+            native_set_folder(This, item);
+        free(dir);
+    }
+    if (This->options & FOS_PICKFOLDERS)
+        set_file_name(This, ctx->paths[0]);
+    else
+        set_file_name(This, PathFindFileNameW(ctx->paths[0]));
+
+    if ((This->options & FOS_OVERWRITEPROMPT) && This->dlg_type == ITEMDLG_TYPE_SAVE)
+    {
+        for (i = 0; SUCCEEDED(hr) && i < ctx->count; i++)
+        {
+            if (FAILED(IShellItemArray_GetItemAt(This->psia_results, i, &item))) continue;
+            if (shell_item_exists(item)) hr = events_OnOverwrite(This, item);
+            IShellItem_Release(item);
+        }
+        if (FAILED(hr)) return S_FALSE;
+    }
+
+    return events_OnFileOk(This) == S_OK ? S_OK : S_FALSE;
+}
+
+/* FALSE: the Wine dialog instead; *parked when the hidden window waits behind it. */
+static BOOL native_dialog_show(FileDialogImpl *This, HWND owner, HRESULT *result, BOOL *parked)
+{
+    struct macdlg_session session;
+    struct native_context ctx;
+    struct macdlg_json json, last;
+    struct macdlg_owner owner_state;
+    IShellItem *folder;
+    BOOL first = TRUE, fallback = FALSE;
+    HRESULT hr;
+    UINT i;
+    int state;
+
+    if (This->native_active || This->dlg_hwnd) return FALSE;
+    /* NSOpenPanel cannot take the name of a file that does not exist yet. */
+    if (This->dlg_type == ITEMDLG_TYPE_OPEN && (This->options & FOS_CREATEPROMPT)) return FALSE;
+    if (!macdlg_enabled()) return FALSE;
+
+    This->native_active = TRUE;
+    This->native_window_asked = FALSE;
+    This->native_close = FALSE;
+
+    /* The owner stays disabled until Show() returns, OnFileOk included; like
+       DialogBox, from before the dialog window exists. */
+    macdlg_disable_owner(&owner_state, owner);
+
+    /* The dialog window exists, hidden, before the first event: programs that
+       ask for it in their handlers get it (GetWindow), as with the Wine dialog. */
+    if (!native_shadow_create(This, owner))
+    {
+        macdlg_restore_owner(&owner_state, FALSE);
+        This->native_active = FALSE;
+        return FALSE;
+    }
+
+    /* Start like the Wine dialog: navigate to the folder, then announce the file type. */
+    folder = This->psi_setfolder ? This->psi_setfolder : This->psi_defaultfolder;
+    if (folder)
+    {
+        events_OnFolderChanging(This, folder);
+        IShellItem_AddRef(folder);
+        native_set_folder(This, folder);
+        events_OnFolderChange(This);
+    }
+    if (This->filterspec_count)
+        events_OnTypeChange(This);
+
+    /* A program that asked for the dialog window just now put its own windows
+       into it; under the panel nobody would see them. Unless
+       MACSW_NATIVE_FILE_DIALOGS=all, the visible Wine dialog instead: its
+       handlers run again there, with that window. */
+    if (This->native_window_asked && !macdlg_everywhere())
+    {
+        TRACE("the program asked for the dialog window, using the Wine dialog\n");
+        native_shadow_park(This);
+        *parked = TRUE;
+        macdlg_restore_owner(&owner_state, FALSE);
+        This->native_active = FALSE;
+        return FALSE;
+    }
+
+    hr = This->native_close ? This->native_close_hr : S_FALSE;
+    while (hr == S_FALSE && !This->native_close)
+    {
+        macdlg_json_init(&json);
+        native_write_request(This, &json);
+        if (!macdlg_begin(&session, owner, &json))
+        {
+            macdlg_json_free(&json);
+            fallback = first;
+            hr = E_FAIL;
+            break;
+        }
+        macdlg_json_free(&json);
+
+        memset(&ctx, 0, sizeof(ctx));
+        ctx.This = This;
+        ctx.session = &session;
+        ctx.panel_type = This->filetypeindex;
+        This->native_filename_changed = FALSE;
+        This->native_folder_changed = FALSE;
+        native_controls_json(This, &last);
+
+        while (!(state = macdlg_step(&session, native_on_line, &ctx)) && !ctx.done)
+        {
+            if (This->native_close && !session.cancelled)
+                macdlg_cancel(&session);
+            native_push_update(This, &ctx, &last);
+            /* Backstop for SetWindowPos(SWP_SHOWWINDOW | SWP_NOSENDCHANGING),
+               which WM_WINDOWPOSCHANGING cannot see. */
+            if (This->dlg_hwnd && IsWindowVisible(This->dlg_hwnd))
+            {
+                WARN("the program showed the hidden dialog window, hiding it\n");
+                ShowWindow(This->dlg_hwnd, SW_HIDE);
+            }
+        }
+        macdlg_json_free(&last);
+        macdlg_end(&session);
+
+        if (state == MACDLG_NOT_STARTED)
+        {
+            fallback = first;
+            hr = E_FAIL;
+        }
+        else if (This->native_close)
+            hr = This->native_close_hr;
+        else if (state < 0 || !ctx.ok || !ctx.count)
+            hr = HRESULT_FROM_WIN32(ERROR_CANCELLED);
+        else
+        {
+            hr = native_accept(This, &ctx);
+            if (This->native_close) hr = This->native_close_hr;
+        }
+        This->native_prompted = FALSE;
+
+        for (i = 0; i < ctx.count; i++) free(ctx.paths[i]);
+        free(ctx.paths);
+        if (fallback) break;
+        first = FALSE;
+        /* S_FALSE: OnFileOk (or OnOverwrite) refused; show the panel again where the user was. */
+    }
+    /* After OnFileOk, as Windows destroys its dialog; before the owner is
+       enabled again, and while handlers still see a native Show(). */
+    if (fallback)
+    {
+        native_shadow_park(This);
+        *parked = TRUE;
+    }
+    else
+        native_shadow_destroy(This);
+    This->native_active = FALSE;
+
+    /* The first panel could not start: the Wine dialog instead. */
+    if (fallback)
+    {
+        macdlg_restore_owner(&owner_state, FALSE);
+        return FALSE;
+    }
+
+    macdlg_restore_owner(&owner_state, TRUE);
+    TRACE("native panel returns 0x%08lx\n", hr);
+    *result = hr;
+    return TRUE;
+}
+
