+#ifndef _WINE_COMDLG32_MACDLG_H
+#define _WINE_COMDLG32_MACDLG_H
+
+/*
+ * With MACSW_NATIVE_FILE_DIALOGS=1 (and winemac.drv loaded) GetOpenFileName,
+ * GetSaveFileName and IFileDialog::Show use NSOpenPanel/NSSavePanel through
+ * winemac.drv's macsw_file_dialog export. Unset or any other value keeps the
+ * Wine dialogs. The panel is asynchronous; the calling thread keeps pumping
+ * its messages, with the owner disabled like a modal dialog.
+ *
+ * An IFileDialog whose program asks for the dialog window (IOleWindow) while
+ * the dialog opens keeps the Wine dialog: the program is about to put its own
+ * windows into it. MACSW_NATIVE_FILE_DIALOGS=all shows the panel there too.
+ *
+ * MACSW_NATIVE_FILE_DIALOG_TEST (automation only) ends every native panel by
+ * itself: "cancel", or a newline separated list of unix paths to return.
+ * MACSW_NATIVE_FILE_DIALOG_TEST_DELAY_MS keeps the real panel up that long
+ * first, _TEST_TYPE picks a 1-based "Format" entry and _TEST_CONTROLS sets
+ * accessory controls ("<control id>=<value>;..."), as if done by the user.
+ */
+
+struct macdlg_json
+{
+    char  *data;
+    size_t len;
+    size_t size;
+    BOOL   comma;
+};
+
+struct macdlg_session
+{
+    int    dialog;
+    HWND   owner;
+    BOOL   quit;
+    WPARAM quit_code;
+    BOOL   started;     /* the panel reported that it is on screen */
+    BOOL   cancelled;   /* comdlg32 asked the panel to end */
+    DWORD  begin_time;
+    char  *buffer;
+    UINT   buffer_size;
+};
+
+/* What the owner looked like before the panel (macdlg_disable_owner). */
+struct macdlg_owner
+{
+    HWND owner;
+    HWND disabled;
+    HWND active;
+    HWND focus;
+};
+
+/* macdlg_step: the panel did not come up; the caller may use the Wine dialog. */
+#define MACDLG_NOT_STARTED (-2)
+
+typedef void (*macdlg_line_callback)(void *context, int argc, char **argv);
+
+extern BOOL macdlg_enabled(void);
+extern BOOL macdlg_everywhere(void);
+extern char *macdlg_unix_path(const WCHAR *dos_path);
+extern WCHAR *macdlg_dos_path(const char *unix_path);
+
+extern void macdlg_json_init(struct macdlg_json *json);
