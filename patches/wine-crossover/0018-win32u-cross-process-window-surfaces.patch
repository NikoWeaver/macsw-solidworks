     case WM_WINE_SETPIXELFORMAT:
         set_window_pixel_format( hwnd, wparam, lparam );
         return 0;
+    case WM_WINE_FOREIGN_SURFACE:
+        update_foreign_surface( hwnd, (HWND)wparam, lparam );
+        return 0;
     case WM_WINE_TRACKMOUSEEVENT:
     {
         TRACKMOUSEEVENT info;
