+    if (!nurbs) return;
+    if (nurbs->state != STATE_NONE)
+    {
+        nurbs_error( nurbs, nurbs->state == STATE_CURVE ? GLU_NURBS_ERROR6 : GLU_NURBS_ERROR27 );
+        return;
+    }
+    clear_maps( nurbs );
+    nurbs->state = STATE_CURVE;
+}
