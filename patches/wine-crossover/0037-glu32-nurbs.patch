+/***********************************************************************
+ *		gluDeleteNurbsRenderer (GLU32.@)
+ */
+void WINAPI wine_gluDeleteNurbsRenderer( GLUnurbs *nurbs )
+{
+    TRACE( "(%p)\n", nurbs );
