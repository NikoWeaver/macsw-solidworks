diff --git a/dlls/glu32/nurbs.c b/dlls/glu32/nurbs.c
new file mode 100644
index 0000000..d890156
--- /dev/null
+++ b/dlls/glu32/nurbs.c
@@ -0,0 +1,1481 @@
+/*
+ * GLU 1.3 NURBS curves and surfaces
+ *
+ * Copyright 2026 MacSW maintainers
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Curves and surfaces are evaluated with de Boor's algorithm, one knot span at a time, and put out
+ * as line strips, quad strips and triangles: with glBegin/glVertex in GLU_NURBS_RENDERER mode, or
+ * through the GLU_NURBS_BEGIN/VERTEX/NORMAL/COLOR/TEXTURE_COORD/END callbacks in
+ * GLU_NURBS_TESSELLATOR mode. The sampling method gives the number of steps per knot span, and the
+ * MAX_*_STEPS limits keep a tiny tolerance from making a huge loop. A surface grid, or the trimming
+ * loops of a surface, that would need more than MAX_FLOATS floats give GLU_OUT_OF_MEMORY.
+ *
+ * Trimming is approximate. The trimming loops are sampled in the (s, t) domain. A grid vertex is
+ * kept when its winding number is positive (a counterclockwise loop keeps its inside, a clockwise
+ * loop cuts a hole; when no loop is counterclockwise, the whole domain is the outer boundary). A
+ * grid cell is drawn when at least three of its corners are kept, so a trimmed edge is accurate to
+ * about one grid cell.
+ */
+
+#include <math.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wine/wgl.h"
+#include "wine/glu.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(glu);
+
+#define MAX_ORDER        24     /* highest order (degree + 1), as in the SGI sample implementation */
+#define MAX_SPAN_STEPS   1024   /* line segments per knot span of a curve */
+#define MAX_CURVE_STEPS  65536  /* line segments per curve (at least one per knot span) */
+#define MAX_GRID_STEPS   256    /* grid steps along s or t of a surface (at least one per knot span) */
+#define MAX_TRIM_STEPS   256    /* line segments per knot span of a trimming curve */
+#define BEHIND_EYE_STEPS 64     /* steps for a knot span with a control point behind the eye */
+#define MAX_FLOATS       (1 << 26)  /* largest copy of control points (256 MB), largest surface grid */
+
+enum { SLOT_VERTEX, SLOT_NORMAL, SLOT_COLOR, SLOT_TEXTURE, SLOT_COUNT };
+enum nurbs_state { STATE_NONE, STATE_CURVE, STATE_SURFACE, STATE_TRIM };
+
+static const struct
+{
+    GLenum curve, surface;
+    int dim, slot;
+}
+map_types[] =
+{
+    { GL_MAP1_VERTEX_3, GL_MAP2_VERTEX_3, 3, SLOT_VERTEX },
+    { GL_MAP1_VERTEX_4, GL_MAP2_VERTEX_4, 4, SLOT_VERTEX },
+    { GL_MAP1_NORMAL, GL_MAP2_NORMAL, 3, SLOT_NORMAL },
+    { GL_MAP1_COLOR_4, GL_MAP2_COLOR_4, 4, SLOT_COLOR },
+    { GL_MAP1_INDEX, GL_MAP2_INDEX, 1, SLOT_COLOR },
+    { GL_MAP1_TEXTURE_COORD_1, GL_MAP2_TEXTURE_COORD_1, 1, SLOT_TEXTURE },
+    { GL_MAP1_TEXTURE_COORD_2, GL_MAP2_TEXTURE_COORD_2, 2, SLOT_TEXTURE },
+    { GL_MAP1_TEXTURE_COORD_3, GL_MAP2_TEXTURE_COORD_3, 3, SLOT_TEXTURE },
+    { GL_MAP1_TEXTURE_COORD_4, GL_MAP2_TEXTURE_COORD_4, 4, SLOT_TEXTURE },
+};
+
+/* one curve (knots[1] == NULL, count[1] == 1) or surface, with copies of its knots and points */
+struct nurbs_map
+{
+    GLenum type;          /* 0: not set */
+    int dim;              /* floats per control point */
+    int order[2];         /* along s (the curve parameter) and t */
+    int count[2];         /* control points along s and t */
+    GLfloat *knots[2];    /* count + order knots each */
+    GLfloat *ctl;         /* point (i, j) at ctl[(i * count[1] + j) * dim] */
+};
+
+/* one piece of a trimming loop: a NURBS curve, or a piecewise linear curve */
+struct trim_piece
+{
+    struct trim_piece *next;
+    struct nurbs_map map;   /* map.type is 0 for a piecewise linear curve */
+    int npoints;
+    GLfloat *points;        /* (s, t) pairs of a piecewise linear curve */
+};
+
+struct trim_loop
+{
+    struct trim_loop *next;
+    struct trim_piece *pieces, **tail;
+    int npoints;            /* the sampled loop, made in gluEndSurface */
+    GLfloat *points;
+};
+
+struct GLUnurbs
+{
+    enum nurbs_state state;
+    GLenum sampling_method, display_mode, mode;
+    GLfloat sampling_tolerance, parametric_tolerance, u_step, v_step;
+    GLboolean culling, auto_load;
+    GLfloat model[16], proj[16];
+    GLint viewport[4];
+    struct nurbs_map maps[SLOT_COUNT];
+    struct trim_loop *loops;
+    void (CALLBACK *error)( GLenum );
+    void (CALLBACK *begin)( GLenum );
+    void (CALLBACK *vertex)( GLfloat * );
+    void (CALLBACK *normal)( GLfloat * );
+    void (CALLBACK *color)( GLfloat * );
+    void (CALLBACK *texcoord)( GLfloat * );
+    void (CALLBACK *end)( void );
+    /* the _DATA forms get a NULL user pointer: glu32 does not export gluNurbsCallbackData */
+    void (CALLBACK *begin_data)( GLenum, void * );
+    void (CALLBACK *vertex_data)( GLfloat *, void * );
+    void (CALLBACK *normal_data)( GLfloat *, void * );
+    void (CALLBACK *color_data)( GLfloat *, void * );
+    void (CALLBACK *texcoord_data)( GLfloat *, void * );
+    void (CALLBACK *end_data)( void * );
+};
+
+struct sampler
+{
+    GLenum method;
+    GLfloat tolerance;
+    GLfloat steps[2];       /* GLU_U_STEP and GLU_V_STEP */
+    GLfloat matrix[16];     /* projection * modelview */
+    GLfloat half_width, half_height;
+};
+
+/* what is put out with each vertex */
+struct vertex_format
+{
+    int dim;                /* of the vertex map: 3 or 4 */
+    GLenum color;           /* type of the color map, or 0 */
+    int tex_dim;            /* of the texture map, or 0 */
+    BOOL normal;            /* a normal map, or computed normals (surfaces) */
+    BOOL compute_normal;
+};
+
+struct nurbs_vertex
+{
+    GLfloat pos[4], normal[3], color[4], tex[4];
+};
+
+struct crossing
+{
+    GLfloat s;
+    int dir;
+};
+
+static void *nurbs_alloc( size_t size )
+{
+    return HeapAlloc( GetProcessHeap(), 0, size );
+}
+
+static void nurbs_free( void *ptr )
+{
+    HeapFree( GetProcessHeap(), 0, ptr );
+}
+
+static void nurbs_error( GLUnurbs *nurbs, GLenum code )
+{
+    WARN( "%p: error %u\n", nurbs, code );
+    if (nurbs->error) nurbs->error( code );
+}
+
+/* checks one knot vector like the GLU_NURBS_ERROR1-5 descriptions; returns 0 or the error */
+static GLenum check_knots( GLint nknots, const GLfloat *knots, GLint order )
+{
+    GLint i, mult = 1;
+
+    if (order < 1 || order > MAX_ORDER) return GLU_NURBS_ERROR1;
+    if (nknots < 2 * order) return GLU_NURBS_ERROR2;
+    if (!knots) return GLU_NURBS_ERROR32;
+    for (i = 0; i < nknots - 1; i++)
+    {
+        if (!(knots[i] <= knots[i + 1])) return GLU_NURBS_ERROR4;  /* also a NaN */
+        if (knots[i] < knots[i + 1]) mult = 1;
+        else if (++mult > order) return GLU_NURBS_ERROR5;
+    }
+    if (!isfinite( knots[0] ) || !isfinite( knots[nknots - 1] )) return GLU_NURBS_ERROR32;
+    if (!(knots[order - 1] < knots[nknots - order])) return GLU_NURBS_ERROR3;
+    return 0;
+}
+
+static void free_map( struct nurbs_map *map )
+{
+    nurbs_free( map->knots[0] );
+    nurbs_free( map->knots[1] );
+    nurbs_free( map->ctl );
+    memset( map, 0, sizeof(*map) );
+}
+
+/* checks and copies a curve (dirs == 1) or a surface (dirs == 2); returns 0 or the error */
+static GLenum copy_map( struct nurbs_map *map, GLenum type, int dim, int dirs, const GLint *nknots,
+                        GLfloat * const *knots, const GLint *stride, const GLint *order,
+                        const GLfloat *ctl )
+{
+    double floats = dim;
+    size_t i, j;
+    GLenum err;
+    int d;
+
+    memset( map, 0, sizeof(*map) );
+    for (d = 0; d < dirs; d++)
+    {
+        if ((err = check_knots( nknots[d], knots[d], order[d] ))) return err;
+        if (stride[d] < 0) return GLU_NURBS_ERROR34;
+        floats *= nknots[d] - order[d];
+    }
+    if (!ctl) return GLU_NURBS_ERROR36;
+    if (floats > MAX_FLOATS) return GLU_OUT_OF_MEMORY;
+
+    map->type = type;
+    map->dim = dim;
+    map->order[1] = map->count[1] = 1;
+    for (d = 0; d < dirs; d++)
+    {
+        map->order[d] = order[d];
+        map->count[d] = nknots[d] - order[d];
+        if (!(map->knots[d] = nurbs_alloc( nknots[d] * sizeof(GLfloat) ))) goto oom;
+        memcpy( map->knots[d], knots[d], nknots[d] * sizeof(GLfloat) );
+    }
+    if (!(map->ctl = nurbs_alloc( (size_t)floats * sizeof(GLfloat) ))) goto oom;
+    for (i = 0; i < map->count[0]; i++)
+        for (j = 0; j < map->count[1]; j++)
+            memcpy( map->ctl + (i * map->count[1] + j) * dim,
+                    ctl + i * stride[0] + (dirs > 1 ? j * stride[1] : 0), dim * sizeof(GLfloat) );
+    return 0;
+
+oom:
+    free_map( map );
+    return GLU_OUT_OF_MEMORY;
+}
+
+/* knot span of u: knots[span] <= u < knots[span + 1], the last span for the end of the range;
+ * u is clamped to the valid range [knots[order - 1], knots[count]] */
+static int find_span( const GLfloat *knots, int order, int count, GLfloat *u )
+{
+    int lo = order - 1, hi = count, mid;
+
+    if (*u >= knots[hi])
+    {
+        *u = knots[hi];
+        for (lo = hi - 1; knots[lo] == knots[hi]; lo--) ;
+        return lo;
+    }
+    if (!(*u > knots[lo])) *u = knots[lo];  /* also a NaN */
+    while (hi - lo > 1)
+    {
+        mid = (lo + hi) / 2;
+        if (knots[mid] <= *u) lo = mid;
+        else hi = mid;
+    }
+    return lo;
+}
+
+/* de Boor's algorithm on the knot span "span" (knots[span] <= u <= knots[span + 1]). pts holds the
+ * control points span - order + 1 ... span (dim floats each) and is overwritten. The point goes to
+ * out, and the first derivative to deriv when it is not NULL. */
+static void de_boor( const GLfloat *knots, int span, int order, int dim, GLfloat u, GLfloat *pts,
+                     GLfloat *out, GLfloat *deriv )
+{
+    int p = order - 1, r, k, c, j;
+    GLfloat a, scale;
+
+    if (!p && deriv) memset( deriv, 0, dim * sizeof(GLfloat) );
+    for (r = 1; r <= p; r++)
+    {
+        if (r == p && deriv)
+        {
+            scale = p / (knots[span + 1] - knots[span]);
+            for (c = 0; c < dim; c++) deriv[c] = scale * (pts[p * dim + c] - pts[(p - 1) * dim + c]);
+        }
+        for (k = p; k >= r; k--)
+        {
+            j = span - p + k;
+            a = (u - knots[j]) / (knots[j + p + 1 - r] - knots[j]);
+            for (c = 0; c < dim; c++)
+                pts[k * dim + c] = (1 - a) * pts[(k - 1) * dim + c] + a * pts[k * dim + c];
+        }
+    }
+    memcpy( out, pts + p * dim, dim * sizeof(GLfloat) );
+}
+
+/* a curve point on a known knot span */
+static void eval_curve_span( const struct nurbs_map *map, int span, GLfloat u, GLfloat *out, GLfloat *deriv )
+{
+    GLfloat pts[MAX_ORDER * 4];
+    int order = map->order[0];
+
+    memcpy( pts, map->ctl + (size_t)(span - order + 1) * map->dim, order * map->dim * sizeof(GLfloat) );
+    de_boor( map->knots[0], span, order, map->dim, u, pts, out, deriv );
+}
+
+/* a curve point (t is not used) or a surface point, with the derivatives along s and t */
+static void eval_map( const struct nurbs_map *map, GLfloat s, GLfloat t, GLfloat *out, GLfloat *ds, GLfloat *dt )
+{
+    GLfloat rows[MAX_ORDER * 4], drows[MAX_ORDER * 4], pts[MAX_ORDER * 4];
+    int so = map->order[0], to = map->order[1], dim = map->dim, ss, ts, i;
+
+    ss = find_span( map->knots[0], so, map->count[0], &s );
+    if (!map->knots[1])
+    {
+        eval_curve_span( map, ss, s, out, ds );
+        return;
+    }
+    ts = find_span( map->knots[1], to, map->count[1], &t );
+    for (i = 0; i < so; i++)
+    {
+        memcpy( pts, map->ctl + ((size_t)(ss - so + 1 + i) * map->count[1] + ts - to + 1) * dim,
+                to * dim * sizeof(GLfloat) );
+        de_boor( map->knots[1], ts, to, dim, t, pts, rows + i * dim, dt ? drows + i * dim : NULL );
+    }
+    if (dt) de_boor( map->knots[0], ss, so, dim, s, drows, dt, NULL );
+    de_boor( map->knots[0], ss, so, dim, s, rows, out, ds );
+}
+
+static void init_sampler( GLUnurbs *nurbs, struct sampler *smp )
+{
+    int r, c, k;
+
+    smp->method = nurbs->sampling_method;
+    if (smp->method == GLU_PATH_LENGTH || smp->method == GLU_OBJECT_PATH_LENGTH)
+        smp->tolerance = nurbs->sampling_tolerance;
+    else
+        smp->tolerance = nurbs->parametric_tolerance;
+    smp->steps[0] = nurbs->u_step;
+    smp->steps[1] = nurbs->v_step;
+    if (nurbs->auto_load && (nurbs->culling || smp->method == GLU_PATH_LENGTH ||
+                             smp->method == GLU_PARAMETRIC_ERROR))
+    {
+        glGetFloatv( GL_MODELVIEW_MATRIX, nurbs->model );
+        glGetFloatv( GL_PROJECTION_MATRIX, nurbs->proj );
+        glGetIntegerv( GL_VIEWPORT, nurbs->viewport );
+    }
+    for (c = 0; c < 4; c++)
+        for (r = 0; r < 4; r++)
+            for (smp->matrix[c * 4 + r] = 0, k = 0; k < 4; k++)
+                smp->matrix[c * 4 + r] += nurbs->proj[k * 4 + r] * nurbs->model[c * 4 + k];
+    smp->half_width = nurbs->viewport[2] / 2.0f;
+    smp->half_height = nurbs->viewport[3] / 2.0f;
+}
+
+static void clip_point( const struct sampler *smp, const GLfloat *p, int dim, GLfloat *clip )
+{
+    GLfloat w = dim == 4 ? p[3] : 1.0f;
+    int r;
+
+    for (r = 0; r < 4; r++)
+        clip[r] = smp->matrix[r] * p[0] + smp->matrix[4 + r] * p[1] + smp->matrix[8 + r] * p[2] +
+                  smp->matrix[12 + r] * w;
+}
+
+/* a control point where the tolerance is measured: in window pixels or in object coordinates;
+ * FALSE when it has no such position (behind the eye, or at infinity) */
+static BOOL measure_point( const struct sampler *smp, const GLfloat *p, int dim, GLfloat *out )
+{
+    GLfloat w = dim == 4 ? p[3] : 1.0f, clip[4];
+
+    if (smp->method == GLU_OBJECT_PATH_LENGTH || smp->method == GLU_OBJECT_PARAMETRIC_ERROR)
+    {
+        if (w == 0.0f) return FALSE;
+        out[0] = p[0] / w;
+        out[1] = p[1] / w;
+        out[2] = p[2] / w;
+        return TRUE;
+    }
+    clip_point( smp, p, dim, clip );
+    if (!(clip[3] > 0.0f)) return FALSE;
+    out[0] = clip[0] / clip[3] * smp->half_width;
+    out[1] = clip[1] / clip[3] * smp->half_height;
+    out[2] = 0.0f;
+    return TRUE;
+}
+
+static GLfloat point_distance( const GLfloat *a, const GLfloat *b )
+{
+    return sqrtf( (a[0] - b[0]) * (a[0] - b[0]) + (a[1] - b[1]) * (a[1] - b[1]) + (a[2] - b[2]) * (a[2] - b[2]) );
+}
+
+static int clamp_steps( float n, int limit )
+{
+    if (!(n >= 1.0f)) return 1;  /* also a NaN */
+    if (n >= limit) return limit;
+    return ceilf( n );
+}
+
+/* steps for one knot span of length range along dir, from its order control points (stride
+ * floats apart): path length / tolerance, or sqrt(d (d - 1) |second difference| / (8 tolerance))
+ * for a parametric error, or range * GLU_U_STEP (GLU_V_STEP) for the domain distance */
+static int span_steps( const struct sampler *smp, int dir, const GLfloat *pts, size_t stride, int order,
+                       int dim, GLfloat range )
+{
+    GLfloat q[MAX_ORDER][3], d[3], length = 0.0f, bend = 0.0f, b;
+    int i, c;
+
+    if (smp->method == GLU_DOMAIN_DISTANCE) return clamp_steps( range * smp->steps[dir], MAX_SPAN_STEPS );
+    for (i = 0; i < order; i++)
+        if (!measure_point( smp, pts + i * stride, dim, q[i] )) return BEHIND_EYE_STEPS;
+    if (smp->method == GLU_PATH_LENGTH || smp->method == GLU_OBJECT_PATH_LENGTH)
+    {
+        for (i = 1; i < order; i++) length += point_distance( q[i - 1], q[i] );
+        return clamp_steps( length / smp->tolerance, MAX_SPAN_STEPS );
+    }
+    for (i = 2; i < order; i++)
+    {
+        for (c = 0; c < 3; c++) d[c] = q[i][c] - 2 * q[i - 1][c] + q[i - 2][c];
+        b = sqrtf( d[0] * d[0] + d[1] * d[1] + d[2] * d[2] );
+        if (b > bend) bend = b;
+    }
+    return clamp_steps( sqrtf( (order - 1) * (order - 2) * bend / (8 * smp->tolerance) ), MAX_SPAN_STEPS );
+}
+
+/* GLU_CULLING: TRUE when every control point is outside the same clip plane */
+static BOOL culled( const struct sampler *smp, const struct nurbs_map *map )
+{
+    size_t i, n = (size_t)map->count[0] * map->count[1];
+    GLfloat clip[4];
+    int outside = 0x3f, flags;
+
+    for (i = 0; i < n && outside; i++)
+    {
+        clip_point( smp, map->ctl + i * map->dim, map->dim, clip );
+        flags = 0;
+        if (clip[0] < -clip[3]) flags |= 0x01;
+        if (clip[0] > clip[3]) flags |= 0x02;
+        if (clip[1] < -clip[3]) flags |= 0x04;
+        if (clip[1] > clip[3]) flags |= 0x08;
+        if (clip[2] < -clip[3]) flags |= 0x10;
+        if (clip[2] > clip[3]) flags |= 0x20;
+        outside &= flags;
+    }
+    return outside != 0;
+}
+
+static void out_begin( GLUnurbs *nurbs, GLenum mode )
+{
+    if (nurbs->mode == GLU_NURBS_RENDERER) glBegin( mode );
+    else if (nurbs->begin_data) nurbs->begin_data( mode, NULL );
+    else if (nurbs->begin) nurbs->begin( mode );
+}
+
+static void out_end( GLUnurbs *nurbs )
+{
+    if (nurbs->mode == GLU_NURBS_RENDERER) glEnd();
+    else if (nurbs->end_data) nurbs->end_data( NULL );
+    else if (nurbs->end) nurbs->end();
+}
+
+static void out_vertex( GLUnurbs *nurbs, const struct vertex_format *fmt, const struct nurbs_vertex *v )
+{
+    GLfloat pos[4], normal[3], color[4], tex[4], w = fmt->dim == 4 ? v->pos[3] : 1.0f;
+
+    memcpy( pos, v->pos, sizeof(pos) );
+    memcpy( normal, v->normal, sizeof(normal) );
+    memcpy( color, v->color, sizeof(color) );
+    memcpy( tex, v->tex, sizeof(tex) );
+    if (w != 1.0f && w != 0.0f)  /* a point at infinity (w == 0) keeps its direction */
+    {
+        pos[0] /= w;
+        pos[1] /= w;
+        pos[2] /= w;
+    }
+    if (nurbs->mode == GLU_NURBS_RENDERER)
+    {
+        if (fmt->color == GL_MAP1_INDEX || fmt->color == GL_MAP2_INDEX) glIndexf( color[0] );
+        else if (fmt->color) glColor4fv( color );
+        if (fmt->normal) glNormal3fv( normal );
+        switch (fmt->tex_dim)
+        {
+        case 1: glTexCoord1fv( tex ); break;
+        case 2: glTexCoord2fv( tex ); break;
+        case 3: glTexCoord3fv( tex ); break;
+        case 4: glTexCoord4fv( tex ); break;
+        }
+        if (w != 0.0f) glVertex3fv( pos );
+        else glVertex4fv( v->pos );
+        return;
+    }
+    if (fmt->color)
+    {
+        if (nurbs->color_data) nurbs->color_data( color, NULL );
+        else if (nurbs->color) nurbs->color( color );
+    }
+    if (fmt->normal)
+    {
+        if (nurbs->normal_data) nurbs->normal_data( normal, NULL );
+        else if (nurbs->normal) nurbs->normal( normal );
+    }
+    if (fmt->tex_dim)
+    {
+        if (nurbs->texcoord_data) nurbs->texcoord_data( tex, NULL );
+        else if (nurbs->texcoord) nurbs->texcoord( tex );
+    }
+    if (nurbs->vertex_data) nurbs->vertex_data( pos, NULL );
+    else if (nurbs->vertex) nurbs->vertex( pos );
+}
+
+static void init_format( GLUnurbs *nurbs, struct vertex_format *fmt, BOOL surface )
+{
+    fmt->dim = nurbs->maps[SLOT_VERTEX].dim;
+    fmt->color = nurbs->maps[SLOT_COLOR].type;
+    fmt->tex_dim = nurbs->maps[SLOT_TEXTURE].dim;
+    fmt->compute_normal = FALSE;
+    if (!nurbs->maps[SLOT_NORMAL].type && surface)
+    {
+        /* like GL_AUTO_NORMAL for evaluators; the tessellator always computes them */
+        if (nurbs->mode == GLU_NURBS_RENDERER) fmt->compute_normal = glIsEnabled( GL_AUTO_NORMAL );
+        else fmt->compute_normal = nurbs->normal || nurbs->normal_data;
+    }
+    fmt->normal = nurbs->maps[SLOT_NORMAL].type || fmt->compute_normal;
+    /* evaluated colors, normals and texture coordinates do not change the current ones */
+    if (nurbs->mode == GLU_NURBS_RENDERER && (fmt->color || fmt->normal || fmt->tex_dim))
+        glPushAttrib( GL_CURRENT_BIT );
+}
+
+static void done_format( GLUnurbs *nurbs, const struct vertex_format *fmt )
+{
+    if (nurbs->mode == GLU_NURBS_RENDERER && (fmt->color || fmt->normal || fmt->tex_dim))
+        glPopAttrib();
+}
+
+/* evaluates the attribute maps of a vertex at (s, t) */
+static void eval_attributes( GLUnurbs *nurbs, const struct vertex_format *fmt, GLfloat s, GLfloat t,
+                             struct nurbs_vertex *v )
+{
+    GLfloat len;
+
+    if (nurbs->maps[SLOT_NORMAL].type)
+    {
+        eval_map( &nurbs->maps[SLOT_NORMAL], s, t, v->normal, NULL, NULL );
+        len = sqrtf( v->normal[0] * v->normal[0] + v->normal[1] * v->normal[1] + v->normal[2] * v->normal[2] );
+        if (len > 0.0f && isfinite( len ))
+        {
+            v->normal[0] /= len;
+            v->normal[1] /= len;
+            v->normal[2] /= len;
+        }
+    }
+    if (fmt->color) eval_map( &nurbs->maps[SLOT_COLOR], s, t, v->color, NULL, NULL );
+    if (fmt->tex_dim) eval_map( &nurbs->maps[SLOT_TEXTURE], s, t, v->tex, NULL, NULL );
+}
+
+static void surface_vertex( GLUnurbs *nurbs, const struct vertex_format *fmt, GLfloat s, GLfloat t,
+                            struct nurbs_vertex *v, GLfloat *last_normal )
+{
+    const struct nurbs_map *map = &nurbs->maps[SLOT_VERTEX];
+    GLfloat ds[4], dt[4], a[3], b[3], n[3], len;
+    int c;
+
+    memset( v, 0, sizeof(*v) );
+    v->pos[3] = 1.0f;
+    v->color[3] = 1.0f;
+    v->tex[3] = 1.0f;
+    if (!fmt->compute_normal)
+    {
+        eval_map( map, s, t, v->pos, NULL, NULL );
+        eval_attributes( nurbs, fmt, s, t, v );
+        return;
+    }
+    eval_map( map, s, t, v->pos, ds, dt );
+    for (c = 0; c < 3; c++)  /* rational: w^2 times the derivatives of the projected point */
+    {
+        a[c] = map->dim == 4 ? ds[c] * v->pos[3] - ds[3] * v->pos[c] : ds[c];
+        b[c] = map->dim == 4 ? dt[c] * v->pos[3] - dt[3] * v->pos[c] : dt[c];
+    }
+    n[0] = a[1] * b[2] - a[2] * b[1];
+    n[1] = a[2] * b[0] - a[0] * b[2];
+    n[2] = a[0] * b[1] - a[1] * b[0];
+    len = sqrtf( n[0] * n[0] + n[1] * n[1] + n[2] * n[2] );
+    if (len > 0.0f && isfinite( len ))  /* a degenerate point (a pole) keeps the last normal */
+    {
+        last_normal[0] = n[0] / len;
+        last_normal[1] = n[1] / len;
+        last_normal[2] = n[2] / len;
+    }
+    memcpy( v->normal, last_normal, 3 * sizeof(GLfloat) );
+    eval_attributes( nurbs, fmt, s, t, v );
+}
+
+static int knot_multiplicity( const GLfloat *knots, int index )
+{
+    int i = index;
+
+    while (i > 0 && knots[i - 1] == knots[index]) i--;
+    return index - i + 1;
+}
+
+static void draw_curve( GLUnurbs *nurbs )
+{
+    const struct nurbs_map *map = &nurbs->maps[SLOT_VERTEX];
+    struct vertex_format fmt;
+    struct nurbs_vertex v;
+    struct sampler smp;
+    int span, order = map->order[0], steps, i, total = 0;
+    GLfloat u0, u1, u, scale = 1.0f;
+    double wanted = 0.0;
+    BOOL open = FALSE;
+
+    if (!map->type)
+    {
+        nurbs_error( nurbs, GLU_NURBS_ERROR8 );
+        return;
+    }
+    init_sampler( nurbs, &smp );
+    if (nurbs->culling && culled( &smp, map )) return;
+    /* first pass: the steps of the whole curve, scaled down when there are more than MAX_CURVE_STEPS */
+    for (span = order - 1; span < map->count[0]; span++)
+    {
+        u0 = map->knots[0][span];
+        u1 = map->knots[0][span + 1];
+        if (u0 < u1) wanted += span_steps( &smp, 0, map->ctl + (size_t)(span - order + 1) * map->dim, map->dim,
+                                           order, map->dim, u1 - u0 );
+    }
+    if (wanted > MAX_CURVE_STEPS) scale = MAX_CURVE_STEPS / wanted;
+    init_format( nurbs, &fmt, FALSE );
+    for (span = order - 1; span < map->count[0]; span++)
+    {
+        u0 = map->knots[0][span];
+        u1 = map->knots[0][span + 1];
+        if (!(u0 < u1)) continue;
+        /* the curve can jump at a knot of full multiplicity: start a new strip there */
+        if (open && knot_multiplicity( map->knots[0], span ) >= order)
+        {
+            out_end( nurbs );
+            open = FALSE;
+        }
+        steps = span_steps( &smp, 0, map->ctl + (size_t)(span - order + 1) * map->dim, map->dim, order,
+                            map->dim, u1 - u0 );
+        if (scale < 1.0f) steps = max( 1, (int)(steps * scale) );
+        i = open ? 1 : 0;
+        if (!open) out_begin( nurbs, GL_LINE_STRIP );
+        open = TRUE;
+        for (; i <= steps; i++)
+        {
+            u = i == steps ? u1 : u0 + (u1 - u0) * i / steps;
+            memset( &v, 0, sizeof(v) );
+            v.pos[3] = v.color[3] = v.tex[3] = 1.0f;
+            eval_curve_span( map, span, u, v.pos, NULL );
+            eval_attributes( nurbs, &fmt, u, 0.0f, &v );
+            out_vertex( nurbs, &fmt, &v );
+        }
+        total += steps;
+    }
+    if (open) out_end( nurbs );
+    done_format( nurbs, &fmt );
+    TRACE( "%p: %d segments\n", nurbs, total );
+}
+
+/* the parameter values of the grid along dir, at least one step per knot span; NULL if out of memory,
+ * or if there are more values than vertices fit in the largest grid (see draw_surface) */
+static GLfloat *grid_params( const struct sampler *smp, const struct nurbs_map *map, int dir, int *count )
+{
+    const GLfloat *knots = map->knots[dir];
+    int order = map->order[dir], n = map->count[dir], other = map->count[!dir];
+    size_t stride = dir ? map->dim : (size_t)map->count[1] * map->dim;
+    size_t row = dir ? (size_t)map->count[1] * map->dim : map->dim;
+    int span, j, i, k = 0, total = 0, s, *steps;
+    double wanted = 0.0;  /* a double: many knot spans of MAX_SPAN_STEPS each can pass INT_MAX */
+    GLfloat *params, range;
+
+    if (!(steps = nurbs_alloc( n * sizeof(int) ))) return NULL;
+    for (span = order - 1; span < n; span++)
+    {
+        steps[span] = 0;
+        range = knots[span + 1] - knots[span];
+        if (!(range > 0.0f)) continue;
+        for (j = 0; j < other; j++)
+        {
+            s = span_steps( smp, dir, map->ctl + (span - order + 1) * stride + j * row, stride, order,
+                            map->dim, range );
+            if (s > steps[span]) steps[span] = s;
+            if (smp->method == GLU_DOMAIN_DISTANCE) break;
+        }
+        wanted += steps[span];
+    }
+    for (span = order - 1; span < n; span++)
+    {
+        if (!steps[span]) continue;
+        if (wanted > MAX_GRID_STEPS)
+            steps[span] = max( 1, (int)((double)steps[span] * MAX_GRID_STEPS / wanted) );
+        total += steps[span];
+        /* checked on each span, so total stays far below INT_MAX */
+        if ((size_t)total + 1 > MAX_FLOATS * sizeof(GLfloat) / sizeof(struct nurbs_vertex))
+        {
+            nurbs_free( steps );
+            return NULL;
+        }
+    }
+    if (!(params = nurbs_alloc( ((size_t)total + 1) * sizeof(GLfloat) )))
+    {
+        nurbs_free( steps );
+        return NULL;
+    }
+    for (span = order - 1; span < n; span++)
+    {
+        if (!steps[span]) continue;
+        for (i = k ? 1 : 0; i <= steps[span]; i++)
+            params[k++] = i == steps[span] ? knots[span + 1] :
+                          knots[span] + (knots[span + 1] - knots[span]) * i / steps[span];
+    }
+    nurbs_free( steps );
+    *count = k;
+    return params;
+}
+
+/* samples every trimming loop into an (s, t) polyline, with steps about "step" long; FALSE if out of
+ * memory, or if all loops together have more than MAX_FLOATS / 2 points (the gluPwlCurve limit) */
+static BOOL sample_trims( GLUnurbs *nurbs, GLfloat step )
+{
+    struct trim_loop *loop;
+    struct trim_piece *piece;
+    const struct nurbs_map *map;
+    GLfloat p[3], q[MAX_ORDER][2], length, u0, u1, u;
+    int span, steps, i, k, n, total = 0;
+
+    for (loop = nurbs->loops; loop; loop = loop->next)
+    {
+        /* first pass counts the points (total + n stays <= MAX_FLOATS / 2), second pass stores them */
+        for (k = 0; k < 2; k++)
+        {
+            n = 0;
+            for (piece = loop->pieces; piece; piece = piece->next)
+            {
+                if (!(map = &piece->map)->type)
+                {
+                    if (!k && piece->npoints > MAX_FLOATS / 2 - total - n) return FALSE;
+                    if (k) memcpy( loop->points + 2 * n, piece->points, piece->npoints * 2 * sizeof(GLfloat) );
+                    n += piece->npoints;
+                    continue;
+                }
+                for (span = map->order[0] - 1; span < map->count[0]; span++)
+                {
+                    u0 = map->knots[0][span];
+                    u1 = map->knots[0][span + 1];
+                    if (!(u0 < u1)) continue;
+                    for (i = 0, length = 0.0f; i < map->order[0]; i++)
+                    {
+                        const GLfloat *c = map->ctl + (size_t)(span - map->order[0] + 1 + i) * map->dim;
+                        GLfloat w = map->dim == 3 ? c[2] : 1.0f;
+                        q[i][0] = c[0] / w;
+                        q[i][1] = c[1] / w;
+                        if (i) length += sqrtf( (q[i][0] - q[i - 1][0]) * (q[i][0] - q[i - 1][0]) +
+                                                (q[i][1] - q[i - 1][1]) * (q[i][1] - q[i - 1][1]) );
+                    }
+                    steps = clamp_steps( length / step, MAX_TRIM_STEPS );
+                    if (!k)
+                    {
+                        if (steps + 1 > MAX_FLOATS / 2 - total - n) return FALSE;
+                        n += steps + 1;
+                        continue;
+                    }
+                    for (i = 0; i <= steps; i++, n++)
+                    {
+                        u = i == steps ? u1 : u0 + (u1 - u0) * i / steps;
+                        eval_curve_span( map, span, u, p, NULL );
+                        if (map->dim == 3 && p[2] != 0.0f)
+                        {
+                            p[0] /= p[2];
+                            p[1] /= p[2];
+                        }
+                        loop->points[2 * n] = p[0];
+                        loop->points[2 * n + 1] = p[1];
+                    }
+                }
+            }
+            if (!k)
+            {
+                nurbs_free( loop->points );
+                loop->npoints = 0;
+                if (!(loop->points = nurbs_alloc( max( n, 1 ) * 2 * sizeof(GLfloat) ))) return FALSE;
+            }
+        }
+        loop->npoints = n;
+        total += n;
+    }
+    return TRUE;
+}
+
+static int __cdecl compare_crossings( const void *a, const void *b )
+{
+    const struct crossing *x = a, *y = b;
+
+    return x->s < y->s ? -1 : x->s > y->s ? 1 : 0;
+}
+
+/* which grid vertices the trimming loops keep (scan line per grid row); NULL if out of memory */
+static BYTE *trim_mask( GLUnurbs *nurbs, const GLfloat *sp, int ns, const GLfloat *tp, int nt )
+{
+    const struct trim_loop *loop;
+    struct crossing *crossings;
+    const GLfloat *a, *b;
+    size_t segments = 0;
+    int i, j, k, n, wind, base = 1;
+    GLfloat area, t, s;
+    BYTE *mask;
+
+    for (loop = nurbs->loops; loop; loop = loop->next)
+    {
+        segments += loop->npoints;
+        for (k = 0, area = 0.0f; k < loop->npoints; k++)
+        {
+            a = loop->points + 2 * k;
+            b = loop->points + 2 * ((k + 1) % loop->npoints);
+            area += a[0] * b[1] - b[0] * a[1];
+        }
+        if (area > 0.0f) base = 0;  /* a counterclockwise loop is an outer boundary */
+    }
+    if (!(mask = nurbs_alloc( (size_t)ns * nt ))) return NULL;
+    if (!(crossings = nurbs_alloc( max( segments, 1 ) * sizeof(*crossings) )))
+    {
+        nurbs_free( mask );
+        return NULL;
+    }
+    for (j = 0; j < nt; j++)
+    {
+        t = tp[j];
+        n = wind = 0;
+        for (loop = nurbs->loops; loop; loop = loop->next)
+        {
+            for (k = 0; k < loop->npoints; k++)
+            {
+                a = loop->points + 2 * k;
+                b = loop->points + 2 * ((k + 1) % loop->npoints);
+                if ((a[1] <= t) == (b[1] <= t)) continue;
+                s = a[0] + (t - a[1]) * (b[0] - a[0]) / (b[1] - a[1]);
+                if (isnan( s )) continue;
+                crossings[n].s = s;
+                crossings[n].dir = b[1] > a[1] ? 1 : -1;  /* upward edges count on the right of a point */
+                wind += crossings[n++].dir;
+            }
+        }
+        qsort( crossings, n, sizeof(*crossings), compare_crossings );
+        for (i = k = 0; i < ns; i++)
+        {
+            while (k < n && crossings[k].s <= sp[i]) wind -= crossings[k++].dir;
+            mask[j * ns + i] = base + wind > 0;
+        }
+    }
+    nurbs_free( crossings );
+    return mask;
+}
+
+#define KEPT(i, j) (!mask || mask[(j) * ns + (i)])
+
+static void draw_grid_fill( GLUnurbs *nurbs, const struct vertex_format *fmt, const struct nurbs_vertex *grid,
+                            const BYTE *mask, int ns, int nt )
+{
+    const struct nurbs_vertex *row0, *row1, *quad[4], *tri[3];
+    int i, j, k, start = 0, kept, triangles;
+
+    for (j = 0; j + 1 < nt; j++)
+    {
+        row0 = grid + j * ns;
+        row1 = row0 + ns;
+        /* quad strips over the columns that are kept in both rows, like glEvalMesh2 */
+        for (i = 0; i < ns; i = max( i, start + 1 ))
+        {
+            for (start = i; i < ns && KEPT( i, j ) && KEPT( i, j + 1 ); i++) ;
+            if (i - start < 2) continue;
+            out_begin( nurbs, GL_QUAD_STRIP );
+            for (k = start; k < i; k++)
+            {
+                out_vertex( nurbs, fmt, row0 + k );
+                out_vertex( nurbs, fmt, row1 + k );
+            }
+            out_end( nurbs );
+        }
+        if (!mask) continue;
+        /* a cell with three kept corners is a triangle, in the winding order of the quads */
+        for (i = triangles = 0; i + 1 < ns; i++)
+        {
+            quad[0] = KEPT( i, j ) ? row0 + i : NULL;
+            quad[1] = KEPT( i, j + 1 ) ? row1 + i : NULL;
+            quad[2] = KEPT( i + 1, j + 1 ) ? row1 + i + 1 : NULL;
+            quad[3] = KEPT( i + 1, j ) ? row0 + i + 1 : NULL;
+            for (k = kept = 0; k < 4; k++)
+            {
+                if (!quad[k]) continue;
+                if (kept < 3) tri[kept] = quad[k];
+                kept++;
+            }
+            if (kept != 3) continue;
+            if (!triangles++) out_begin( nurbs, GL_TRIANGLES );
+            for (k = 0; k < 3; k++) out_vertex( nurbs, fmt, tri[k] );
+        }
+        if (triangles) out_end( nurbs );
+    }
+}
+
+/* line strips along the grid rows (dir 0) or columns (dir 1), broken where a vertex is trimmed away */
+static void draw_grid_lines( GLUnurbs *nurbs, const struct vertex_format *fmt, const struct nurbs_vertex *grid,
+                             const BYTE *mask, int ns, int nt, int dir )
+{
+    int a, b, start = 0, na = dir ? ns : nt, nb = dir ? nt : ns, k;
+
+    for (a = 0; a < na; a++)
+    {
+        for (b = 0; b < nb; b = max( b, start + 1 ))
+        {
+            for (start = b; b < nb && (dir ? KEPT( a, b ) : KEPT( b, a )); b++) ;
+            if (b - start < 2) continue;
+            out_begin( nurbs, GL_LINE_STRIP );
+            for (k = start; k < b; k++) out_vertex( nurbs, fmt, dir ? grid + k * ns + a : grid + a * ns + k );
+            out_end( nurbs );
+        }
+    }
+}
+
+static void draw_outline_patch( GLUnurbs *nurbs, const struct vertex_format *fmt, const struct nurbs_vertex *grid,
+                                int ns, int nt, GLfloat *last_normal )
+{
+    const struct trim_loop *loop;
+    struct nurbs_vertex v;
+    int i;
+
+    if (!nurbs->loops)
+    {
+        out_begin( nurbs, GL_LINE_STRIP );
+        for (i = 0; i < ns; i++) out_vertex( nurbs, fmt, grid + i );
+        for (i = 1; i < nt; i++) out_vertex( nurbs, fmt, grid + i * ns + ns - 1 );
+        for (i = ns - 2; i >= 0; i--) out_vertex( nurbs, fmt, grid + (nt - 1) * ns + i );
+        for (i = nt - 2; i >= 0; i--) out_vertex( nurbs, fmt, grid + i * ns );
+        out_end( nurbs );
+        return;
+    }
+    for (loop = nurbs->loops; loop; loop = loop->next)
+    {
+        if (!loop->npoints) continue;
+        out_begin( nurbs, GL_LINE_STRIP );
+        for (i = 0; i <= loop->npoints; i++)
+        {
+            const GLfloat *p = loop->points + 2 * (i % loop->npoints);
+            surface_vertex( nurbs, fmt, p[0], p[1], &v, last_normal );
+            out_vertex( nurbs, fmt, &v );
+        }
+        out_end( nurbs );
+    }
+}
+
+static void draw_surface( GLUnurbs *nurbs )
+{
+    const struct nurbs_map *map = &nurbs->maps[SLOT_VERTEX];
+    GLfloat *sp = NULL, *tp = NULL, last_normal[3] = { 0.0f, 0.0f, 1.0f }, step;
+    struct nurbs_vertex *grid = NULL;
+    struct vertex_format fmt;
+    struct sampler smp;
+    BYTE *mask = NULL;
+    int ns = 0, nt = 0, i, j;
+
+    if (!map->type)
+    {
+        nurbs_error( nurbs, GLU_NURBS_ERROR8 );
+        return;
+    }
+    init_sampler( nurbs, &smp );
+    if (nurbs->culling && culled( &smp, map )) return;
+    if (!(sp = grid_params( &smp, map, 0, &ns )) || !(tp = grid_params( &smp, map, 1, &nt ))) goto oom;
+    if ((double)ns * nt * sizeof(*grid) > (double)MAX_FLOATS * sizeof(GLfloat)) goto oom;
+    if (nurbs->loops)
+    {
+        step = 0.5f * min( (sp[ns - 1] - sp[0]) / (ns - 1), (tp[nt - 1] - tp[0]) / (nt - 1) );
+        if (!sample_trims( nurbs, step ) || !(mask = trim_mask( nurbs, sp, ns, tp, nt ))) goto oom;
+    }
+    if (!(grid = nurbs_alloc( (size_t)ns * nt * sizeof(*grid) ))) goto oom;
+
+    init_format( nurbs, &fmt, TRUE );
+    for (j = 0; j < nt; j++)
+        for (i = 0; i < ns; i++)
+            surface_vertex( nurbs, &fmt, sp[i], tp[j], grid + j * ns + i, last_normal );
+    switch (nurbs->display_mode)
+    {
+    case GLU_OUTLINE_POLYGON:
+        draw_grid_lines( nurbs, &fmt, grid, mask, ns, nt, 0 );
+        draw_grid_lines( nurbs, &fmt, grid, mask, ns, nt, 1 );
+        break;
+    case GLU_OUTLINE_PATCH:
+        draw_outline_patch( nurbs, &fmt, grid, ns, nt, last_normal );
+        break;
+    default:
+        draw_grid_fill( nurbs, &fmt, grid, mask, ns, nt );
+        break;
+    }
+    done_format( nurbs, &fmt );
+    TRACE( "%p: %d x %d grid%s\n", nurbs, ns, nt, mask ? ", trimmed" : "" );
+    goto done;
+
+oom:
+    nurbs_error( nurbs, GLU_OUT_OF_MEMORY );
+done:
+    nurbs_free( grid );
+    nurbs_free( mask );
+    nurbs_free( tp );
+    nurbs_free( sp );
+}
+
+static void free_trims( GLUnurbs *nurbs )
+{
+    struct trim_loop *loop;
+    struct trim_piece *piece;
+
+    while ((loop = nurbs->loops))
+    {
+        nurbs->loops = loop->next;
+        while ((piece = loop->pieces))
+        {
+            loop->pieces = piece->next;
+            free_map( &piece->map );
+            nurbs_free( piece->points );
+            nurbs_free( piece );
+        }
+        nurbs_free( loop->points );
+        nurbs_free( loop );
+    }
+}
+
+static void clear_maps( GLUnurbs *nurbs )
+{
+    int i;
+
+    for (i = 0; i < SLOT_COUNT; i++) free_map( &nurbs->maps[i] );
+}
+
+/* adds a piece to the trimming loop that gluBeginTrim started */
+static struct trim_piece *add_trim_piece( GLUnurbs *nurbs )
+{
+    struct trim_piece *piece;
+
+    if (!(piece = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*piece) )))
+    {
+        nurbs_error( nurbs, GLU_OUT_OF_MEMORY );
+        return NULL;
+    }
+    *nurbs->loops->tail = piece;
+    nurbs->loops->tail = &piece->next;
+    return piece;
+}
