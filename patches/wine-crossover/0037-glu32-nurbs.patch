+ */
+void WINAPI wine_gluEndCurve( GLUnurbs *nurbs )
+{
+    TRACE( "(%p)\n", nurbs );
+    if (!nurbs) return;
+    if (nurbs->state != STATE_CURVE)
+    {
+        nurbs_error( nurbs, GLU_NURBS_ERROR7 );
+        return;
+    }
+    draw_curve( nurbs );
+    clear_maps( nurbs );
+    nurbs->state = STATE_NONE;
+}
+
+/***********************************************************************
+ *		gluNurbsCurve (GLU32.@)
+ */
+void WINAPI wine_gluNurbsCurve( GLUnurbs *nurbs, GLint nknots, GLfloat *knot,
+                                GLint stride, GLfloat *ctlarray, GLint order, GLenum type )
+{
+    struct trim_piece *piece;
+    struct nurbs_map map;
+    GLenum err;
+    int i;
+
+    TRACE( "(%p, %d, %p, %d, %p, %d, %#x)\n", nurbs, nknots, knot, stride, ctlarray, order, type );
+    if (!nurbs) return;
+
+    if (type == GLU_MAP1_TRIM_2 || type == GLU_MAP1_TRIM_3)
+    {
+        if (nurbs->state != STATE_TRIM)
+        {
+            nurbs_error( nurbs, GLU_NURBS_ERROR22 );
+            return;
+        }
+        if ((err = copy_map( &map, type, type == GLU_MAP1_TRIM_2 ? 2 : 3, 1, &nknots, &knot, &stride,
+                             &order, ctlarray )))
+        {
+            nurbs_error( nurbs, err );
+            return;
+        }
+        if (!(piece = add_trim_piece( nurbs ))) free_map( &map );
+        else piece->map = map;
+        return;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(map_types); i++) if (map_types[i].curve == type) break;
+    if (i == ARRAY_SIZE(map_types))
+    {
+        nurbs_error( nurbs, nurbs->state == STATE_TRIM ? GLU_NURBS_ERROR14 : GLU_NURBS_ERROR35 );
+        return;
+    }
+    if (nurbs->state == STATE_TRIM)
+    {
+        nurbs_error( nurbs, GLU_NURBS_ERROR14 );
+        return;
+    }
+    if (nurbs->state == STATE_SURFACE)
+    {
+        nurbs_error( nurbs, GLU_NURBS_ERROR8 );
+        return;
+    }
+    if ((err = copy_map( &map, type, map_types[i].dim, 1, &nknots, &knot, &stride, &order, ctlarray )))
+    {
+        nurbs_error( nurbs, err );
+        return;
+    }
+    free_map( &nurbs->maps[map_types[i].slot] );
+    nurbs->maps[map_types[i].slot] = map;
+    if (nurbs->state == STATE_NONE)  /* outside gluBeginCurve/gluEndCurve: draw it now */
+    {
+        draw_curve( nurbs );
+        clear_maps( nurbs );
+    }
+}
+
+/***********************************************************************
+ *		gluBeginSurface (GLU32.@)
+ */
+void WINAPI wine_gluBeginSurface( GLUnurbs *nurbs )
+{
+    TRACE( "(%p)\n", nurbs );
+    if (!nurbs) return;
+    if (nurbs->state != STATE_NONE)
+    {
+        nurbs_error( nurbs, nurbs->state == STATE_CURVE ? GLU_NURBS_ERROR6 : GLU_NURBS_ERROR27 );
+        return;
+    }
+    clear_maps( nurbs );
+    free_trims( nurbs );
+    nurbs->state = STATE_SURFACE;
+}
+
+/***********************************************************************
+ *		gluEndSurface (GLU32.@)
+ */
+void WINAPI wine_gluEndSurface( GLUnurbs *nurbs )
+{
+    TRACE( "(%p)\n", nurbs );
+    if (!nurbs) return;
+    if (nurbs->state == STATE_TRIM)
+    {
+        nurbs_error( nurbs, GLU_NURBS_ERROR12 );
+        nurbs->state = STATE_SURFACE;
+    }
+    if (nurbs->state != STATE_SURFACE)
+    {
+        nurbs_error( nurbs, GLU_NURBS_ERROR13 );
+        return;
+    }
+    draw_surface( nurbs );
+    clear_maps( nurbs );
+    free_trims( nurbs );
+    nurbs->state = STATE_NONE;
+}
+
+/***********************************************************************
+ *		gluNurbsSurface (GLU32.@)
+ */
+void WINAPI wine_gluNurbsSurface( GLUnurbs *nurbs, GLint sknot_count, float *sknot, GLint tknot_count,
+                                  GLfloat *tknot, GLint s_stride, GLint t_stride, GLfloat *ctlarray,
+                                  GLint sorder, GLint torder, GLenum type )
+{
+    GLint nknots[2] = { sknot_count, tknot_count }, stride[2] = { s_stride, t_stride }, order[2] = { sorder, torder };
+    GLfloat *knots[2] = { sknot, tknot };
+    struct nurbs_map map;
+    GLenum err;
+    int i;
+
+    TRACE( "(%p, %d, %p, %d, %p, %d, %d, %p, %d, %d, %#x)\n", nurbs, sknot_count, sknot, tknot_count,
+           tknot, s_stride, t_stride, ctlarray, sorder, torder, type );
+    if (!nurbs) return;
+
+    for (i = 0; i < ARRAY_SIZE(map_types); i++) if (map_types[i].surface == type) break;
+    if (i == ARRAY_SIZE(map_types))
+    {
+        nurbs_error( nurbs, GLU_NURBS_ERROR35 );
+        return;
+    }
+    if (nurbs->state == STATE_CURVE || nurbs->state == STATE_TRIM)
+    {
+        nurbs_error( nurbs, GLU_NURBS_ERROR8 );
+        return;
+    }
+    if ((err = copy_map( &map, type, map_types[i].dim, 2, nknots, knots, stride, order, ctlarray )))
+    {
+        nurbs_error( nurbs, err );
+        return;
+    }
+    free_map( &nurbs->maps[map_types[i].slot] );
+    nurbs->maps[map_types[i].slot] = map;
+    if (nurbs->state == STATE_NONE)  /* outside gluBeginSurface/gluEndSurface: draw it now */
+    {
+        draw_surface( nurbs );
+        clear_maps( nurbs );
+    }
+}
+
+/***********************************************************************
+ *		gluBeginTrim (GLU32.@)
+ */
+void WINAPI wine_gluBeginTrim( GLUnurbs *nurbs )
+{
+    struct trim_loop *loop;
+
+    TRACE( "(%p)\n", nurbs );
+    if (!nurbs) return;
+    if (nurbs->state != STATE_SURFACE)
+    {
+        nurbs_error( nurbs, nurbs->state == STATE_TRIM ? GLU_NURBS_ERROR16 : GLU_NURBS_ERROR15 );
+        return;
+    }
+    if (!(loop = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*loop) )))
+    {
+        nurbs_error( nurbs, GLU_OUT_OF_MEMORY );
+        return;
+    }
+    loop->tail = &loop->pieces;
+    loop->next = nurbs->loops;
+    nurbs->loops = loop;
+    nurbs->state = STATE_TRIM;
+}
