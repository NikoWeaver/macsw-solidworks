+/***********************************************************************
+ *		gluNurbsProperty (GLU32.@)
+ */
+void WINAPI wine_gluNurbsProperty( GLUnurbs *nurbs, GLenum property, GLfloat value )
+{
+    TRACE( "(%p, %u, %f)\n", nurbs, property, value );
+    if (!nurbs) return;
+
+    switch (property)
+    {
+    case GLU_SAMPLING_METHOD:
+        if (value != GLU_PATH_LENGTH && value != GLU_PARAMETRIC_ERROR && value != GLU_DOMAIN_DISTANCE &&
+            value != GLU_OBJECT_PATH_LENGTH && value != GLU_OBJECT_PARAMETRIC_ERROR) break;
+        nurbs->sampling_method = value;
+        return;
+    case GLU_SAMPLING_TOLERANCE:
+        if (!(value > 0.0f)) break;
+        nurbs->sampling_tolerance = value;
+        return;
+    case GLU_PARAMETRIC_TOLERANCE:
+        if (!(value > 0.0f)) break;
+        nurbs->parametric_tolerance = value;
+        return;
+    case GLU_U_STEP:
+        if (!(value > 0.0f)) break;
+        nurbs->u_step = value;
+        return;
+    case GLU_V_STEP:
+        if (!(value > 0.0f)) break;
+        nurbs->v_step = value;
+        return;
+    case GLU_DISPLAY_MODE:
+        if (value != GLU_FILL && value != GLU_OUTLINE_POLYGON && value != GLU_OUTLINE_PATCH) break;
+        nurbs->display_mode = value;
+        return;
+    case GLU_CULLING:
+        nurbs->culling = value != 0.0f;
+        return;
+    case GLU_AUTO_LOAD_MATRIX:
+        nurbs->auto_load = value != 0.0f;
+        return;
+    case GLU_NURBS_MODE:
+        if (value != GLU_NURBS_RENDERER && value != GLU_NURBS_TESSELLATOR) break;
+        nurbs->mode = value;
+        return;
+    default:
+        nurbs_error( nurbs, GLU_INVALID_ENUM );
+        return;
+    }
+    nurbs_error( nurbs, GLU_INVALID_VALUE );
+}
+
+/***********************************************************************
+ *		gluGetNurbsProperty (GLU32.@)
+ */
+void WINAPI wine_gluGetNurbsProperty( GLUnurbs *nurbs, GLenum property, GLfloat *value )
+{
+    TRACE( "(%p, %u, %p)\n", nurbs, property, value );
+    if (!nurbs || !value) return;
+
+    switch (property)
+    {
+    case GLU_SAMPLING_METHOD: *value = nurbs->sampling_method; break;
+    case GLU_SAMPLING_TOLERANCE: *value = nurbs->sampling_tolerance; break;
+    case GLU_PARAMETRIC_TOLERANCE: *value = nurbs->parametric_tolerance; break;
+    case GLU_U_STEP: *value = nurbs->u_step; break;
+    case GLU_V_STEP: *value = nurbs->v_step; break;
+    case GLU_DISPLAY_MODE: *value = nurbs->display_mode; break;
+    case GLU_CULLING: *value = nurbs->culling; break;
+    case GLU_AUTO_LOAD_MATRIX: *value = nurbs->auto_load; break;
+    case GLU_NURBS_MODE: *value = nurbs->mode; break;
+    default: nurbs_error( nurbs, GLU_INVALID_ENUM ); break;
+    }
+}
+
+/***********************************************************************
+ *		gluNurbsCallback (GLU32.@)
+ */
+void WINAPI wine_gluNurbsCallback( GLUnurbs *nurbs, GLenum which, void (CALLBACK *fn)(void) )
+{
+    TRACE( "(%p, %u, %p)\n", nurbs, which, fn );
+    if (!nurbs) return;
+
+    switch (which)
+    {
+    case GLU_NURBS_ERROR: nurbs->error = (void (CALLBACK *)(GLenum))fn; break;
+    case GLU_NURBS_BEGIN: nurbs->begin = (void (CALLBACK *)(GLenum))fn; break;
+    case GLU_NURBS_VERTEX: nurbs->vertex = (void (CALLBACK *)(GLfloat *))fn; break;
+    case GLU_NURBS_NORMAL: nurbs->normal = (void (CALLBACK *)(GLfloat *))fn; break;
+    case GLU_NURBS_COLOR: nurbs->color = (void (CALLBACK *)(GLfloat *))fn; break;
+    case GLU_NURBS_TEXTURE_COORD: nurbs->texcoord = (void (CALLBACK *)(GLfloat *))fn; break;
+    case GLU_NURBS_END: nurbs->end = (void (CALLBACK *)(void))fn; break;
+    case GLU_NURBS_BEGIN_DATA: nurbs->begin_data = (void (CALLBACK *)(GLenum, void *))fn; break;
+    case GLU_NURBS_VERTEX_DATA: nurbs->vertex_data = (void (CALLBACK *)(GLfloat *, void *))fn; break;
+    case GLU_NURBS_NORMAL_DATA: nurbs->normal_data = (void (CALLBACK *)(GLfloat *, void *))fn; break;
+    case GLU_NURBS_COLOR_DATA: nurbs->color_data = (void (CALLBACK *)(GLfloat *, void *))fn; break;
+    case GLU_NURBS_TEXTURE_COORD_DATA: nurbs->texcoord_data = (void (CALLBACK *)(GLfloat *, void *))fn; break;
+    case GLU_NURBS_END_DATA: nurbs->end_data = (void (CALLBACK *)(void *))fn; break;
+    default: nurbs_error( nurbs, GLU_INVALID_ENUM ); break;
+    }
+}
