+/***********************************************************************
+ *		gluNewNurbsRenderer (GLU32.@)
+ */
+GLUnurbs * WINAPI wine_gluNewNurbsRenderer(void)
+{
+    GLUnurbs *nurbs;
+    int i;
+
+    if (!(nurbs = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*nurbs) ))) return NULL;
+    nurbs->sampling_method = GLU_PATH_LENGTH;
+    nurbs->sampling_tolerance = 50.0f;
+    nurbs->parametric_tolerance = 0.5f;
+    nurbs->u_step = nurbs->v_step = 100.0f;
+    nurbs->display_mode = GLU_FILL;
+    nurbs->culling = GL_FALSE;
+    nurbs->auto_load = GL_TRUE;
+    nurbs->mode = GLU_NURBS_RENDERER;
+    for (i = 0; i < 4; i++) nurbs->model[i * 5] = nurbs->proj[i * 5] = 1.0f;
+    nurbs->viewport[2] = nurbs->viewport[3] = 1;
+    TRACE( "() -> %p\n", nurbs );
+    return nurbs;
+}
