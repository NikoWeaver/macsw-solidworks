+/***********************************************************************
+ *              macsw_file_dialog (WINEMAC.@)
+ *
+ * MacSW: lets comdlg32 show NSOpenPanel/NSSavePanel. The call never waits
+ * for the user; comdlg32 polls (MACDRV_FILE_DIALOG_POLL) while it pumps
+ * messages. Returns the dialog id (BEGIN), the poll state (POLL) or 1/0.
+ */
+INT WINAPI macsw_file_dialog(UINT op, UINT dialog, HWND owner, const char *in, UINT in_len,
+                             char *out, UINT out_size, UINT *out_len)
+{
+    struct file_dialog_params params =
+    {
+        .op = op, .dialog = dialog, .owner = HandleToUlong(owner),
+        .in_len = in_len, .in = (UINT_PTR)in, .out = (UINT_PTR)out, .out_size = out_size,
+    };
+
+    if (MACDRV_CALL(file_dialog, &params)) return -1;
+    if (out_len) *out_len = params.out_len;
+    return params.result;
+}
+
 BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
 {
     if (reason != DLL_PROCESS_ATTACH) return TRUE;
