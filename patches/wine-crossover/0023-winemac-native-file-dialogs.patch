+/***********************************************************************
+ *              macdrv_file_dialog
+ *
+ * MacSW: native NSOpenPanel/NSSavePanel for comdlg32 (cocoa_filedialog.m).
+ * Never blocks: the panel runs on the main thread and is polled.
+ */
+static NTSTATUS macdrv_file_dialog(void *arg)
+{
+    struct file_dialog_params *params = arg;
+
+    switch (params->op)
+    {
+    case MACDRV_FILE_DIALOG_BEGIN:
+    {
+        struct macdrv_win_data *data = get_win_data(UlongToHandle(params->owner));
+        macdrv_window owner = (data && data->on_screen) ? data->cocoa_window : NULL;
+
+        /* The window data lock keeps the Cocoa window alive until it is retained. */
+        params->result = macdrv_file_dialog_begin(param_ptr(params->in), params->in_len, owner);
+        release_win_data(data);
+        break;
+    }
+    case MACDRV_FILE_DIALOG_POLL:
+        params->result = macdrv_file_dialog_poll(params->dialog, param_ptr(params->out),
+                                                 params->out_size, &params->out_len);
+        break;
+    case MACDRV_FILE_DIALOG_UPDATE:
+        params->result = macdrv_file_dialog_update(params->dialog, param_ptr(params->in), params->in_len);
+        break;
+    case MACDRV_FILE_DIALOG_CANCEL:
+        params->result = macdrv_file_dialog_cancel(params->dialog);
+        break;
+    case MACDRV_FILE_DIALOG_RELEASE:
+        params->result = macdrv_file_dialog_release(params->dialog);
+        break;
+    default:
+        return STATUS_INVALID_PARAMETER;
+    }
+    return STATUS_SUCCESS;
+}
