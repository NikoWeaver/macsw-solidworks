 	cocoa_event.m \
+	cocoa_filedialog.m \
 	cocoa_main.m \
 	cocoa_opengl.m \
 	cocoa_status_item.m \
@@ -40,4 +41,5 @@ SOURCES = \
 	systray.c \
 	vulkan.c \
 	window.c \
